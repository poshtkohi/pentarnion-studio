{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "base", "hidden": true, "generator": "Ninja",
      "cacheVariables": {"PENTA_BUILD_TESTS": "ON", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
    },
    {
      "name": "windows-base", "hidden": true, "inherits": "base",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "environment": {"PATH": "${sourceDir}/third-party/windows-deps/ucrt64/bin;C:/msys64/ucrt64/bin;$penv{PATH}"},
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/third-party/windows-deps/ucrt64/bin/ninja.exe",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/third-party/windows-deps/ucrt64"
      }
    },
    {"name": "windows-debug", "inherits": "windows-base", "binaryDir": "${sourceDir}/build/windows-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "windows-release", "inherits": "windows-base", "binaryDir": "${sourceDir}/build/windows-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "windows-headless", "inherits": "windows-debug", "binaryDir": "${sourceDir}/build/windows-headless", "cacheVariables": {"PENTA_BUILD_IDE": "OFF"}},
    {
      "name": "linux-base", "hidden": true, "inherits": "base",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "cacheVariables": {"CMAKE_PREFIX_PATH": "${sourceDir}/third-party/linux"}
    },
    {"name": "linux-debug", "inherits": "linux-base", "binaryDir": "${sourceDir}/build/linux-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "linux-release", "inherits": "linux-base", "binaryDir": "${sourceDir}/build/linux-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "linux-headless", "inherits": "linux-debug", "binaryDir": "${sourceDir}/build/linux-headless", "cacheVariables": {"PENTA_BUILD_IDE": "OFF"}}
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "windows-headless", "configurePreset": "windows-headless"},
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "linux-headless", "configurePreset": "linux-headless"}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}},
    {"name": "windows-headless", "configurePreset": "windows-headless", "output": {"outputOnFailure": true}},
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {"name": "linux-headless", "configurePreset": "linux-headless", "output": {"outputOnFailure": true}}
  ]
}
