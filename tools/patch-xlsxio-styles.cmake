# Integration patch for pinned XLSXIO 0.2.37 (MIT). Its empty <fill/> record is
# rejected by independent SpreadsheetML readers. Retain existing style indices
# while emitting the standard none/gray125 fills and the Normal default style.
if(NOT DEFINED XLSXIO_SOURCE_DIR)
  message(FATAL_ERROR "Pass -DXLSXIO_SOURCE_DIR=<pinned XLSXIO source>")
endif()
set(writer "${XLSXIO_SOURCE_DIR}/lib/xlsxio_write.c")
file(READ "${writer}" source)
set(empty_fill [=["<fill/>"]=])
set(valid_fills [=["<fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill>"]=])
string(FIND "${source}" "${empty_fill}" empty_position)
if(NOT empty_position EQUAL -1)
  string(REPLACE [=["<fills count=\"1\">"]=] [=["<fills count=\"2\">"]=] source "${source}")
  string(REPLACE "${empty_fill}" "${valid_fills}" source "${source}")
endif()
set(normal [=[  "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>" OPTIONAL_LINE_BREAK]=])
set(anchor [=[  "<dxfs count=\"0\"/>" OPTIONAL_LINE_BREAK]=])
string(FIND "${source}" "${normal}" normal_position)
if(normal_position EQUAL -1)
  string(FIND "${source}" "${anchor}" anchor_position)
  if(anchor_position EQUAL -1)
    message(FATAL_ERROR "The pinned XLSXIO stylesheet no longer matches its integration patch")
  endif()
  string(REPLACE "${anchor}" "${normal}\n${anchor}" source "${source}")
endif()
string(FIND "${source}" "${valid_fills}" fills_position)
string(FIND "${source}" [=["<fills count=\"2\">"]=] count_position)
if(fills_position EQUAL -1 OR count_position EQUAL -1)
  message(FATAL_ERROR "The pinned XLSXIO fill records no longer match their integration patch")
endif()
file(WRITE "${writer}" "${source}")
message(STATUS "XLSXIO SpreadsheetML fill/default-style patch applied")
