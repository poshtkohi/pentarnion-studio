R"PENTA_HYBRID_M(
function out=pentahybrid(fn,event,reset,initial,options,metadata)
checkoptions(options,{'parameters','t0','t1','sample_step','method','jacobian','rtol','atol','max_steps','max_samples','max_seconds','max_bytes','event_direction','event_terminal','minimum_event_interval','grazing_tolerance','max_events','event_priority','simultaneous','event_time_tolerance','event_gradient_tolerance','sensitivities','sensitivity_parameters','sensitivity_initial'});
names=metadata.states;widths=metadata.widths;parameterNames=metadata.parameters;parameterWidths=metadata.parameter_widths;bindings=opt(options,'parameters',struct);if ~isequal(sort(fieldnames(bindings)),sort(parameterNames(:))),error('Bind every hybrid model parameter exactly once');end
parameters=cell(size(parameterNames));for k=1:numel(parameterNames),parameters{k}=bindings.(parameterNames{k});if parameterWidths(k)==5,parameters{k}=penta_runtime('pent',parameters{k});end;end
flatParameters=penta_runtime('pack',parameters);state=penta_runtime('pack',{initial});n=numel(state);np=numel(flatParameters);started=tic;
if n~=sum(widths)||n<1||n>32||np>64,error('Hybrid target needs complete1..32 state and<=64 parameter coordinates');end
timeValue=opt(options,'t0',0);endTime=opt(options,'t1',1);minimum=opt(options,'minimum_event_interval',1e-8);grazing=opt(options,'grazing_tolerance',1e-10);timeTolerance=opt(options,'event_time_tolerance',1e-8);gradientTolerance=opt(options,'event_gradient_tolerance',1e-8);maximum=opt(options,'max_events',100);maxSteps=opt(options,'max_steps',1000000);maxSamples=opt(options,'max_samples',1000000);maxBytes=opt(options,'max_bytes',128*1024*1024);seconds=opt(options,'max_seconds',120);policy=opt(options,'simultaneous','priority');
if endTime<=timeValue||minimum<=0||grazing<=0||timeTolerance<=0||gradientTolerance<=0||gradientTolerance>=.01||~any(strcmp(policy,{'priority','all'}))||~strcmp(opt(options,'method','bdf'),'bdf')||~strcmp(opt(options,'jacobian','analytic'),'analytic'),error('Invalid hybrid target interval/root policy or unsupported solver mapping');end
[roots,J]=rootad(timeValue,state);components=numel(roots);if components<1||components>16,error('Hybrid event callback needs1..16 real roots');end
scale=sum(abs(J),2);if any(roots==0)||any(scale>0&abs(roots)./max(scale,realmin)<=grazing),error('Hybrid initial state lies on/too near an event surface');end
eventDirections=flags('event_direction',0,-1,1);terminals=flags('event_terminal',0,0,1);priorities=flags('event_priority',0,-1000000,1000000);selection=opt(options,'sensitivities','all');if ~any(strcmp(selection,{'none','parameters','initial','all'})),error('Invalid hybrid sensitivity selection');end
parameterDirections=[];initialDirections=[];if any(strcmp(selection,{'parameters','all'})),parameterDirections=1:np;end
if isfield(options,'sensitivity_parameters'),if any(strcmp(selection,{'initial','all'})),error('Explicit parameter directions cannot combine with initial/all');end;parameterDirections=reshape(options.sensitivity_parameters,1,[]);if any(parameterDirections~=floor(parameterDirections))||any(parameterDirections<1)||any(parameterDirections>np)||numel(unique(parameterDirections))~=numel(parameterDirections),error('Invalid1-based hybrid parameter directions');end;end
if any(strcmp(selection,{'initial','all'})),initialDirections=1:n;end;directions=[parameterDirections,zeros(size(initialDirections))];d=numel(directions);S=zeros(n,d);if ~isempty(initialDirections),S(:,numel(parameterDirections)+1:end)=eye(n);end
if isfield(options,'sensitivity_initial'),S=options.sensitivity_initial;if d==0||~isequal(size(S),[n,d]),error('Hybrid sensitivity seeds need n rows and selected columns');end;end
epochSolutions={};originalSeeds=S;initialState=state;times=zeros(0,1);values=zeros(0,n);slopes=values;sensitivities=zeros(0,n*d);segments=zeros(0,1);sides=segments;eventTimes=zeros(0,1);before=values;after=values;taus=zeros(0,d);fixedBefore=zeros(0,n*d);fixedAfter=fixedBefore;totalBefore=fixedBefore;totalAfter=fixedBefore;saltations=zeros(0,n*n);jumps=zeros(0,n*np);denominators=zeros(0,1);transverse=denominators;indices=denominators;groupIndices=[];groupOffsets=0;segment=1;steps=0;calls=0;eventCalls=0;derivativesAvailable=true;terminal=false;lastEvent=-inf;
