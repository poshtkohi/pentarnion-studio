while timeValue<endTime
    epochStart=timeValue;epochSettings=struct;for key={'sample_step','method','jacobian','rtol','atol','sensitivity_parameters'},name=key{1};if isfield(options,name),epochSettings.(name)=options.(name);end;end
    epochSettings.t0=timeValue;epochSettings.t1=endTime;epochSettings.events=@callback;epochSettings.event_direction=eventDirections;epochSettings.event_terminal=ones(components,1);epochSettings.sensitivities=selection;epochSettings.max_seconds=seconds-toc(started);if d,epochSettings.sensitivity_initial=S;end
    solved=pentaodetarget(fn,names,widths,unpackgroups(state,widths),parameters,epochSettings);epochSolutions{end+1}=solved;stored=solved.metadata;steps=steps+numel(stored.result.x)-1;calls=calls+stored.rhs_evaluations;eventCalls=eventCalls+stored.event_evaluations;
    if steps>maxSteps||toc(started)>seconds,error('Hybrid target aggregate step/wall allowance exceeded');end
    for row=2:numel(solved.fields.t),t=solved.fields.t(row);y=stored.values(row,:).';seed=S;if d,seed=reshape(stored.sensitivities(row,:),n,d);end;side=0;if stored.event_terminal&&row==size(stored.values,1),side=-1;end;append(t,y,seed,side,targetfield(fn,t,y,parameters,widths,[],0));end
    timeValue=solved.fields.t(end);state=stored.values(end,:).';if d,S=reshape(stored.sensitivities(end,:),n,d);end;if ~stored.event_terminal,break;end
    if numel(eventTimes)>=maximum||timeValue-lastEvent<minimum,error('Hybrid target event/chattering allowance exceeded');end;lastEvent=timeValue;
    [roots,J]=rootad(timeValue,state);fminus=targetfield(fn,timeValue,state,parameters,widths,[],0);den=J(:,1)+J(:,2:1+n)*fminus;scale=abs(J(:,1))+sum(abs(J(:,2:1+n).*fminus.'),2);active=[];
    for i=1:components,if (eventDirections(i)==0||sign(den(i))==eventDirections(i))&&(roots(i)==0||(den(i)~=0&&abs(roots(i)/den(i))<=timeTolerance)),active(end+1)=i;end;end
    if isempty(active),error('Localized target event has no identifiable original surface');end;[~,order]=sortrows([priorities(active),active.'],[1,2]);active=active(order);winner=active(1);relative=0;if scale(winner),relative=abs(den(winner))/scale(winner);end;valid=relative>grazing;
    if valid,for i=active,if scale(i)==0||abs(den(i))/scale(i)<=grazing||any(abs(J(i,:)/den(i)-J(winner,:)/den(winner))>gradientTolerance*(1+abs(J(i,:)/den(i))+abs(J(winner,:)/den(winner)))),valid=false;break;end;end;end
    if valid,lastStep=abs(stored.result.x(end)-stored.result.x(end-1));delta=min([sqrt(eps)*max(1,abs(timeValue)),.001*(timeValue-epochStart),.1*lastStep]);if delta>0,[~,probe]=rootad(timeValue-delta,state-delta*fminus);probeDen=probe(:,1)+probe(:,2:1+n)*fminus;if any(abs(den(active))<=grazing*abs(probeDen(active))),valid=false;end;end;end
    if d&&~valid,error('Simultaneous/grazing hybrid branch has undefined or unequal event-time derivatives');end;derivativesAvailable=derivativesAvailable&&valid;applied=winner;if strcmp(policy,'all'),applied=active;end;terminal=any(terminals(applied));if d&&~terminal&&endTime-timeValue<minimum,error('Differentiated hybrid event lies at fixed observation endpoint');end
    pre=state;R=[zeros(n,1),eye(n),zeros(n,np)];post=pre;
    for appliedIndex=applied
        [post,local]=targetad(@resetSeed,[timeValue;post;flatParameters],1);composed=local(:,2:1+n)*R;composed(:,1)=composed(:,1)+local(:,1);composed(:,2+n:end)=composed(:,2+n:end)+local(:,2+n:end);R=composed;
    end
    if numel(post)~=n,error('Reset target callback lost state coefficients');end
    fplus=targetfield(fn,timeValue,post,parameters,widths,[],0);correction=R(:,1)+R(:,2:1+n)*fminus-fplus;denominator=den(winner);if denominator==0,denominator=1;end
    Xi=R(:,2:1+n)-correction*J(winner,2:1+n)/denominator;Bp=R(:,2+n:end)-correction*J(winner,2+n:end)/denominator;tau=zeros(1,d);
    for direction=1:d,numerator=J(winner,2:1+n)*S(:,direction);if directions(direction)>0,numerator=numerator+J(winner,1+n+directions(direction));end;tau(direction)=-numerator/denominator;end
    postS=R(:,2:1+n)*S+correction*tau;for direction=1:d,if directions(direction)>0,postS(:,direction)=postS(:,direction)+R(:,1+n+directions(direction));end;end
    index=numel(eventTimes)+1;eventTimes(index,1)=timeValue;before(index,:)=pre.';after(index,:)=post.';taus(index,:)=tau;fixedBefore(index,:)=S(:).';fixedAfter(index,:)=postS(:).';b=S+fminus*tau;a=postS+fplus*tau;totalBefore(index,:)=b(:).';totalAfter(index,:)=a(:).';saltations(index,:)=reshape(Xi.',1,[]);jumps(index,:)=reshape(Bp.',1,[]);denominators(index,1)=den(winner);transverse(index,1)=relative;indices(index,1)=winner;groupIndices=[groupIndices,active];groupOffsets(end+1)=numel(groupIndices);
    state=post;S=postS;segment=segment+1;append(timeValue,state,S,1,fplus);if terminal,break;end
end
eventInfo=struct('components',components,'indices',indices,'group_offsets',groupOffsets,'group_indices',groupIndices,'directions',eventDirections.','terminal',terminals.','priorities',priorities.','policy',policy,'derivatives_available',double(derivativesAvailable),'time_tolerance',timeTolerance,'gradient_tolerance',gradientTolerance);
layout=struct;for k=1:numel(parameterNames),layout.(parameterNames{k})=struct('offset',1+sum(parameterWidths(1:k-1)),'components',parameterWidths(k));end
terminalTimes=zeros(0,0);terminalValues=terminalTimes;if terminal&&d,terminalTimes=taus(end,:);terminalValues=totalAfter(end,:);end
out=struct('format','PentarnionHybridODE','version',1,'t',times,'values',values,'derivatives',slopes,'sensitivities',sensitivities,'segment_ids',segments,'sides',sides,'event_times',eventTimes,'event_info',eventInfo,'event_before',before,'event_after',after,'event_time_derivatives',taus,'event_fixed_before',fixedBefore,'event_fixed_after',fixedAfter,'event_total_before',totalBefore,'event_total_after',totalAfter,'saltation',saltations,'parameter_jumps',jumps,'event_denominators',denominators,'transversality',transverse,'terminal_time_derivatives',terminalTimes,'terminal_value_derivatives',terminalValues,'dimension',n,'parameter_count',np,'directions',d,'segments',segment,'events',numel(eventTimes),'steps',steps,'evaluations',calls,'sensitivity_evaluations',calls*double(d>0),'event_evaluations',eventCalls,'terminal_event',double(terminal),'cache_hit',0,'elapsed_seconds',toc(started),'cache_key','','event_cache_key','','reset_cache_key','','rhs_derivative_key','','request_hash','','gamma',penta_runtime('gamma'),'initial',initialState.','parameter_values',flatParameters.','direction_parameters',directions,'direction_initials',[zeros(size(parameterDirections)),initialDirections],'initial_seeds',originalSeeds,'state_names',strjoin(names,','),'state_widths',widths,'parameter_layout',layout,'coordinate_layout','flat_declared_state_coefficients','sensitivity_layout','direction_major_then_flat_state','derivative_semantics','fixed-time samples; moving-event total derivatives; explicit target saltation','method','matlab_ode15s_bdf','jacobian','analytic_target_ad2','native_operations',0,'source_hash','','threads_used',1,'status','completed','settings',options);
out.penta_target_epochs=epochSolutions;if terminal,out.status='terminal_event';end
if ~derivativesAvailable,for key={'saltation','parameter_jumps','event_time_derivatives','event_fixed_before','event_fixed_after','event_total_before','event_total_after','terminal_time_derivatives','terminal_value_derivatives'},out.(key{1})=zeros(0,0);end;end
    function [values,J]=rootad(t,y),[values,J]=targetad(@rootSeed,[t;y;flatParameters],1);end
    function value=rootSeed(point),states=unpackgroups(point(2:1+n),widths);params=unpackgroups(point(2+n:end),parameterWidths);value=event(point(1),states{:},params{:});end
    function value=resetSeed(point),states=unpackgroups(point(2:1+n),widths);params=unpackgroups(point(2+n:end),parameterWidths);if metadata.indexed_reset,value=reset(double(appliedIndex),point(1),states{:},params{:});else,value=reset(point(1),states{:},params{:});end;end
    function values=flags(key,fallback,low,high),values=opt(options,key,fallback);values=values(:);if isscalar(values),values=repmat(values,components,1);end;if numel(values)~=components||any(values~=floor(values))||any(values<low)||any(values>high),error('Invalid hybrid per-event flags');end;end
    function append(t,y,s,side,flow)
        row=numel(times)+1;times(row,1)=t;values(row,:)=y.';slopes(row,:)=flow.';sensitivities(row,:)=s(:).';segments(row,1)=segment;sides(row,1)=side;
        if row>maxSamples||(row*(2*n+n*d+3)+numel(eventTimes)*(4*n*d+n*n+n*np+d+2*n+3))*8>maxBytes,error('Hybrid retained-coordinate allowance exceeded');end
    end
    function output=callback(t,varargin)
        output=penta_runtime('pack',{event(t,varargin{:})});if t==epochStart,flow=targetfield(fn,t,state,parameters,widths,[],0);[~,gradient]=rootad(t,state);signs=gradient(:,1)+gradient(:,2:1+n)*flow;for k=1:components,if output(k)==0,value=1;if signs(k)<0,value=-1;end;output(k)=realmin*eps*value;end;end;end
    end
end
function out=pentahybridval(result,query,side)
if nargin<3,side='post';end;if ~any(strcmp(side,{'pre','post'})),error('Hybrid interpolation side is pre/post');end;times=result.t;out=zeros(numel(query),result.dimension);
for index=1:numel(query),t=query(index);if t<times(1)||t>times(end),error('Hybrid query outside retained interval');end;exact=find(times==t);if ~isempty(exact),row=exact(end);if strcmp(side,'pre'),row=exact(1);end;out(index,:)=result.values(row,:);continue;end;right=find(times>t,1);left=right-1;if result.segment_ids(left)~=result.segment_ids(right),error('Hybrid interpolation cannot bridge reset');end;h=times(right)-times(left);u=(t-times(left))/h;out(index,:)=(2*u^3-3*u^2+1)*result.values(left,:)+(u^3-2*u^2+u)*h*result.derivatives(left,:)+(-2*u^3+3*u^2)*result.values(right,:)+(u^3-u^2)*h*result.derivatives(right,:);end
end
)PENTA_HYBRID_M"
