struct Parser {std::string_view text;std::size_t at=0;unsigned tokens=0,depth=0;void spaces(){while(at<text.size()&&(text[at]==' '||text[at]=='\t'))++at;}int integer(){spaces();int sign=1;if(at<text.size()&&(text[at]=='+'||text[at]=='-')){if(text[at++]=='-')sign=-1;}const auto first=at;int v=0;while(at<text.size()&&text[at]>='0'&&text[at]<='9'){v=v*10+text[at++]-'0';if(v>1024)throw Failure(1,"Rational SI exponent numerator/denominator is bounded.");}if(first==at)throw Failure(1,"A rational SI exponent requires integer terms.");return sign*v;}
