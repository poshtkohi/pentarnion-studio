    // Matrix-free CVODES path. Only local coordinate blocks are stored; graph
    // coupling remains incoming CSR and uses no global dense Jacobian.
    std::vector<double> bdfJacobian,bdfJacobianState,bdfFactors;
    std::vector<unsigned char> bdfPivots;
    std::vector<long double> bdfDegree;
    double bdfJacobianTime=0;bool bdfJacobianValid=false;
    std::string bdfFatalError,bdfBackendMessage;
    int bdfFatalStatus=0;
    struct BdfBatch {
        Network& network;unsigned operation;double time=0,scale=0;
        const double* state=nullptr;const double* input=nullptr;double* output=nullptr;
        static int run(void* raw,uint64_t first,uint64_t last,char* error,uint64_t cap)noexcept{
            auto& batch=*static_cast<BdfBatch*>(raw);auto& network=batch.network;const auto& q=network.r;const auto n=q.coordinates;
            try{for(uint64_t node=first;node<last;++node){if(network.host.cancelled&&network.host.cancelled(network.host.context))return PENTA_NUMERIC_CANCELLED;if((node&15)==0&&std::chrono::duration<double>(Clock::now()-network.start).count()>q.max_seconds){message(error,cap,"Network BDF wall-time budget exceeded inside a native node batch.");return 7;}const auto offset=node*n;
                if(batch.operation==0){auto* out=batch.output+offset;const int status=network.host.local(network.host.context,batch.time,batch.state+offset,out,nullptr,error,cap);if(status)return status;for(uint64_t row=0;row<n;++row){long double value=out[row];for(auto a=network.pointers[node];a<network.pointers[node+1];++a){const auto arc=network.arcs[a];value+=network.coupling(arc,row,batch.state+arc.source*n,batch.state+offset);}if(!std::isfinite(value)||std::abs(value)>std::numeric_limits<double>::max())throw Error(PENTA_NUMERIC_DOMAIN,"Network BDF RHS became nonfinite.");out[row]=static_cast<double>(value);}}
                else if(batch.operation==1){std::array<double,32> out{};const int status=network.host.local(network.host.context,batch.time,batch.state+offset,out.data(),network.bdfJacobian.data()+node*n*n,error,cap);if(status)return status;}
                else if(batch.operation==2){const auto* jac=network.bdfJacobian.data()+node*n*n;for(uint64_t row=0;row<n;++row){long double value=0;for(uint64_t col=0;col<n;++col)value+=static_cast<long double>(jac[row*n+col])*batch.input[offset+col];for(auto a=network.pointers[node];a<network.pointers[node+1];++a){const auto arc=network.arcs[a];value+=network.coupling(arc,row,batch.input+arc.source*n,batch.input+offset);}if(!std::isfinite(value)||std::abs(value)>std::numeric_limits<double>::max())throw Error(PENTA_NUMERIC_DOMAIN,"Generated network Jacobian-vector product became nonfinite.");batch.output[offset+row]=static_cast<double>(value);}}
                else if(batch.operation==3){const auto* jac=network.bdfJacobian.data()+node*n*n;auto* lu=network.bdfFactors.data()+node*n*n;auto* pivots=network.bdfPivots.data()+node*n;for(uint64_t row=0;row<n;++row)for(uint64_t col=0;col<n;++col){long double value=-static_cast<long double>(batch.scale)*jac[row*n+col];if(row==col)value+=1;value+=static_cast<long double>(batch.scale)*network.diagonal(node,row,col);if(!std::isfinite(value)||std::abs(value)>std::numeric_limits<double>::max()){message(error,cap,"Block-Jacobi entries overflowed; retry with a smaller BDF step.");return 1;}lu[row*n+col]=static_cast<double>(value);}for(uint64_t k=0;k<n;++k){uint64_t pivot=k;for(uint64_t row=k+1;row<n;++row)if(std::abs(lu[row*n+k])>std::abs(lu[pivot*n+k]))pivot=row;pivots[k]=static_cast<unsigned char>(pivot);if(lu[pivot*n+k]==0){message(error,cap,"Block-Jacobi factor has a zero pivot; retry the nonlinear step.");return 1;}if(pivot!=k)for(uint64_t col=0;col<n;++col)std::swap(lu[k*n+col],lu[pivot*n+col]);for(uint64_t row=k+1;row<n;++row){lu[row*n+k]/=lu[k*n+k];for(uint64_t col=k+1;col<n;++col){lu[row*n+col]-=lu[row*n+k]*lu[k*n+col];if(!std::isfinite(lu[row*n+col])){message(error,cap,"Block-Jacobi elimination overflowed; retry with a smaller BDF step.");return 1;}}}}}
                else {const auto* lu=network.bdfFactors.data()+node*n*n;const auto* pivots=network.bdfPivots.data()+node*n;std::array<double,32> out{};std::copy_n(batch.input+offset,n,out.begin());for(uint64_t k=0;k<n;++k)if(pivots[k]!=k)std::swap(out[k],out[pivots[k]]);for(uint64_t row=0;row<n;++row)for(uint64_t col=0;col<row;++col)out[row]-=lu[row*n+col]*out[col];for(uint64_t row=n;row-->0;){for(uint64_t col=row+1;col<n;++col)out[row]-=lu[row*n+col]*out[col];out[row]/=lu[row*n+row];if(!std::isfinite(out[row]))throw Error(PENTA_NUMERIC_DOMAIN,"Block-Jacobi solve became nonfinite.");}std::copy_n(out.begin(),n,batch.output+offset);}
            }return PENTA_NUMERIC_OK;}catch(const Error& e){message(error,cap,e.what());return e.status;}catch(const std::exception& e){message(error,cap,e.what());return PENTA_NUMERIC_INTERNAL;}catch(...){return PENTA_NUMERIC_INTERNAL;}
        }
    };
    int bdfBatch(BdfBatch& batch,bool recoverable=false){
        const auto n=r.coordinates;const auto cost=batch.operation==1||batch.operation==2||batch.operation==3?n*n:n;
        check(r.nodes*cost+(batch.operation==0||batch.operation==2?arcs.size()*n*(operators?n:1):0));char error[2048]{};
        const int status=host.parallel_for?host.parallel_for(host.context,r.nodes,std::max<uint64_t>(32,cost),BdfBatch::run,&batch,error,sizeof(error)):BdfBatch::run(&batch,0,r.nodes,error,sizeof(error));
        if(status){if(recoverable&&status==1)return 1;throw Error(status,error[0]?error:"Native network BDF worker failed.");}return 0;
    }
    void bdfRefresh(double time,const double* state){
        const auto count=r.nodes*r.coordinates;check(count);
        if(bdfJacobianValid&&time==bdfJacobianTime&&std::equal(bdfJacobianState.begin(),bdfJacobianState.end(),state))return;
        BdfBatch batch{*this,1,time,0,state};bdfBatch(batch);std::copy_n(state,count,bdfJacobianState.begin());bdfJacobianTime=time;bdfJacobianValid=true;result.local_jacobian_evaluations+=r.nodes;
    }
    int bdfFailure(const std::exception& error,int status)noexcept{try{if(bdfFatalError.empty())bdfFatalError=error.what();bdfFatalStatus=status;}catch(...){}return -1;}
    static int bdfRhs(sunrealtype time,N_Vector state,N_Vector out,void* raw)noexcept{
        auto& n=*static_cast<Network*>(raw);try{BdfBatch batch{n,0,time,0,N_VGetArrayPointer(state),nullptr,N_VGetArrayPointer(out)};n.bdfBatch(batch);n.result.rhs_evaluations+=n.r.nodes;return 0;}catch(const Error& e){return n.bdfFailure(e,e.status);}catch(const std::exception& e){return n.bdfFailure(e,PENTA_NUMERIC_INTERNAL);}
    }
    static int bdfJacSetup(sunrealtype time,N_Vector state,N_Vector,void* raw)noexcept{
        auto& n=*static_cast<Network*>(raw);try{n.bdfRefresh(time,N_VGetArrayPointer(state));return 0;}catch(const Error& e){return n.bdfFailure(e,e.status);}catch(const std::exception& e){return n.bdfFailure(e,PENTA_NUMERIC_INTERNAL);}
    }
    static int bdfJtimes(N_Vector input,N_Vector out,sunrealtype time,N_Vector state,N_Vector,void* raw,N_Vector)noexcept{
        auto& n=*static_cast<Network*>(raw);try{n.bdfRefresh(time,N_VGetArrayPointer(state));BdfBatch batch{n,2,time,0,N_VGetArrayPointer(state),N_VGetArrayPointer(input),N_VGetArrayPointer(out)};n.bdfBatch(batch);++n.result.jacobian_vector_products;return 0;}catch(const Error& e){return n.bdfFailure(e,e.status);}catch(const std::exception& e){return n.bdfFailure(e,PENTA_NUMERIC_INTERNAL);}
    }
    static int bdfPrecSetup(sunrealtype time,N_Vector state,N_Vector,sunbooleantype,sunbooleantype* current,sunrealtype scale,void* raw)noexcept{
        auto& n=*static_cast<Network*>(raw);try{n.bdfRefresh(time,N_VGetArrayPointer(state));BdfBatch batch{n,3,time,scale};const int status=n.bdfBatch(batch,true);if(status)return 1;*current=SUNTRUE;n.result.block_factorizations+=n.r.nodes;return 0;}catch(const Error& e){return n.bdfFailure(e,e.status);}catch(const std::exception& e){return n.bdfFailure(e,PENTA_NUMERIC_INTERNAL);}
    }
    static int bdfPrecSolve(sunrealtype time,N_Vector,N_Vector,N_Vector input,N_Vector out,sunrealtype,sunrealtype,int,void* raw)noexcept{
        auto& n=*static_cast<Network*>(raw);try{BdfBatch batch{n,4,time,0,nullptr,N_VGetArrayPointer(input),N_VGetArrayPointer(out)};n.bdfBatch(batch);return 0;}catch(const Error& e){return n.bdfFailure(e,e.status);}catch(const std::exception& e){return n.bdfFailure(e,PENTA_NUMERIC_INTERNAL);}
    }
    static void bdfErrorHandler(int,const char*,const char*,const char* text,SUNErrCode,void* raw,SUNContext)noexcept{try{static_cast<Network*>(raw)->bdfBackendMessage=text?std::string(text).substr(0,2048):"CVODES error.";}catch(...) {}}
    void bdfRequire(int status,const char* operation){if(status<0){if(!bdfFatalError.empty())throw Error(bdfFatalStatus,bdfFatalError.c_str());throw Error(PENTA_NUMERIC_INTERNAL,(std::string("CVODES network ")+operation+" failed ("+std::to_string(status)+"). "+bdfBackendMessage).c_str());}}
    void solveBdf(){
        build();const auto count=r.nodes*r.coordinates;std::vector<double> initial(r.initial,r.initial+count);sample(0,initial);if(r.samples==1){result.elapsed_seconds=std::chrono::duration<double>(Clock::now()-start).count();result.work_units=work;return;}
        bdfJacobian.resize(count*r.coordinates);bdfFactors.resize(count*r.coordinates);bdfPivots.resize(count);bdfJacobianState.resize(count);bdfDegree.resize(r.nodes);for(uint64_t node=0;node<r.nodes;++node)for(auto a=pointers[node];a<pointers[node+1];++a)bdfDegree[node]+=arcs[a].weight;
        struct Resources {SUNContext context=nullptr;N_Vector state=nullptr,output=nullptr;SUNLinearSolver linear=nullptr;void* cvode=nullptr;~Resources(){if(cvode)CVodeFree(&cvode);if(linear)SUNLinSolFree(linear);if(output)N_VDestroy(output);if(state)N_VDestroy(state);if(context)SUNContext_Free(&context);}} resources;
        bdfRequire(SUNContext_Create(SUN_COMM_NULL,&resources.context),"context creation");SUNContext_ClearErrHandlers(resources.context);SUNContext_PushErrHandler(resources.context,bdfErrorHandler,this);resources.state=N_VNew_Serial(static_cast<sunindextype>(count),resources.context);if(!resources.state)throw Error(PENTA_NUMERIC_INTERNAL,"Cannot allocate network BDF state.");resources.output=N_VClone(resources.state);if(!resources.output)throw Error(PENTA_NUMERIC_INTERNAL,"Cannot allocate network dense-sample buffer.");std::copy(initial.begin(),initial.end(),N_VGetArrayPointer(resources.state));resources.cvode=CVodeCreate(CV_BDF,resources.context);if(!resources.cvode)throw Error(PENTA_NUMERIC_INTERNAL,"Cannot allocate network CVODES solver.");bdfRequire(CVodeInit(resources.cvode,bdfRhs,r.times[0],resources.state),"initialization");bdfRequire(CVodeSetUserData(resources.cvode,this),"user data");bdfRequire(CVodeSStolerances(resources.cvode,r.rtol,r.atol),"tolerances");bdfRequire(CVodeSetStopTime(resources.cvode,r.times[r.samples-1]),"stop time");if(r.step>0)bdfRequire(CVodeSetMaxStep(resources.cvode,r.step),"maximum step");
        resources.linear=SUNLinSol_SPGMR(resources.state,SUN_PREC_LEFT,static_cast<int>(r.krylov_dimension),resources.context);if(!resources.linear)throw Error(PENTA_NUMERIC_INTERNAL,"Cannot allocate network SPGMR solver.");bdfRequire(SUNLinSol_SPGMRSetMaxRestarts(resources.linear,5),"Krylov restarts");bdfRequire(CVodeSetLinearSolver(resources.cvode,resources.linear,nullptr),"matrix-free linear solver");bdfRequire(CVodeSetJacTimes(resources.cvode,bdfJacSetup,bdfJtimes),"generated Jacobian-vector product");bdfRequire(CVodeSetPreconditioner(resources.cvode,bdfPrecSetup,bdfPrecSolve),"local block-Jacobi preconditioner");
        double reached=r.times[0];
        for(uint64_t index=1;index<r.samples;++index){
            while(reached<r.times[index]){check();long steps=0;bdfRequire(CVodeGetNumSteps(resources.cvode,&steps),"step count");if(static_cast<uint64_t>(steps)>=r.max_steps)throw Error(7,"Network BDF total step budget exceeded.");bdfRequire(CVodeSetMaxNumSteps(resources.cvode,static_cast<long>(r.max_steps-steps)),"step budget");sunrealtype current=0;const int status=CVode(resources.cvode,r.times[index],resources.state,&current,CV_ONE_STEP);bdfRequire(status,"integration");if(!(current>reached))throw Error(PENTA_NUMERIC_INTERNAL,"CVODES did not advance network time.");reached=current;sunrealtype step=0;bdfRequire(CVodeGetLastStep(resources.cvode,&step),"accepted step");result.largest_step=std::max(result.largest_step,static_cast<double>(step));result.last_step=step;}
            bdfRequire(CVodeGetDky(resources.cvode,r.times[index],0,resources.output),"requested sample interpolation");sample(index,std::span<const double>(N_VGetArrayPointer(resources.output),count));
        }
        long steps=0,linear=0,linearFailures=0,nonlinear=0,failures=0,prec=0,backendRhs=0;bdfRequire(CVodeGetNumSteps(resources.cvode,&steps),"final steps");bdfRequire(CVodeGetNumLinIters(resources.cvode,&linear),"linear statistics");bdfRequire(CVodeGetNumLinConvFails(resources.cvode,&linearFailures),"linear failure statistics");bdfRequire(CVodeGetNumNonlinSolvIters(resources.cvode,&nonlinear),"nonlinear statistics");bdfRequire(CVodeGetNumErrTestFails(resources.cvode,&failures),"error statistics");bdfRequire(CVodeGetNumPrecEvals(resources.cvode,&prec),"preconditioner statistics");bdfRequire(CVodeGetNumRhsEvals(resources.cvode,&backendRhs),"RHS statistics");result.steps=static_cast<uint64_t>(steps);if(result.steps>r.max_steps)throw Error(7,"Network BDF total step budget exceeded.");result.linear_iterations=linear;result.linear_convergence_failures=linearFailures;result.nonlinear_iterations=nonlinear;result.error_test_failures=failures;result.preconditioner_setups=prec;result.backend_rhs_evaluations=backendRhs;sunrealtype last=0;bdfRequire(CVodeGetLastStep(resources.cvode,&last),"last step");result.last_step=last;result.work_units=work;result.elapsed_seconds=std::chrono::duration<double>(Clock::now()-start).count();
    }
