template<class Function>void femRange(Work& work,uint64_t count,uint64_t cost,Function&& function){
    work.check(count*std::max<uint64_t>(cost,1));const auto* host=work.host.struct_size>=sizeof(penta_fem_parallel_host_v1)?reinterpret_cast<const penta_fem_parallel_host_v1*>(&work.host):nullptr;
    if(!host||!host->parallel_for||host->threads_granted<=1||count<64){function(0,count);return;}
    struct Task {Function& function;static int execute(void* raw,uint64_t first,uint64_t last,char* error,uint64_t capacity)noexcept{try{static_cast<Task*>(raw)->function(first,last);return 0;}catch(const std::exception& failure){text(error,capacity,failure.what());return PENTA_NUMERIC_DOMAIN;}catch(...){return PENTA_NUMERIC_INTERNAL;}}} task{function};char error[1024]{};if(host->parallel_for(work.host.context,count,cost,Task::execute,&task,error,sizeof(error)))throw Failure(PENTA_NUMERIC_DOMAIN,error[0]?error:"Shared parallel FEM range failed.");
}
struct ParallelCgResult {bool converged=false;uint64_t iterations=0;double residual=0;};
ParallelCgResult parallelCg(Work& work,const mfem::SparseMatrix& matrix,const mfem::Vector& rhs,mfem::Vector& solution,double rtol,double atol){
    const auto n=static_cast<uint64_t>(matrix.Height());const auto* offsets=matrix.HostReadI();const auto* columns=matrix.HostReadJ();const auto* data=matrix.HostReadData();const auto nnz=static_cast<uint64_t>(matrix.NumNonZeroElems());std::vector<double> x(solution.GetData(),solution.GetData()+n),b(rhs.GetData(),rhs.GetData()+n),diagonal(n),r(n),z(n),p(n),ap(n);ParallelCgResult result;
    auto dot=[&](const std::vector<double>& a,const std::vector<double>& b){const auto groups=(n+1023)/1024;std::vector<long double> sums(groups);femRange(work,groups,1024,[&](uint64_t first,uint64_t last){for(uint64_t group=first;group<last;++group){long double value=0;for(uint64_t i=group*1024;i<std::min(n,(group+1)*1024);++i)value+=static_cast<long double>(a[i])*b[i];sums[group]=value;}});long double sum=0;for(const auto value:sums)sum+=value;return sum;};
    auto multiply=[&](const std::vector<double>& input,std::vector<double>& output){femRange(work,n,std::max<uint64_t>(1,nnz/n),[&](uint64_t first,uint64_t last){for(uint64_t row=first;row<last;++row){long double value=0;for(int k=offsets[row];k<offsets[row+1];++k)value+=static_cast<long double>(data[k])*input[static_cast<uint64_t>(columns[k])];output[row]=static_cast<double>(value);if(!std::isfinite(output[row]))throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM matrix product overflowed.");}});};
    femRange(work,n,std::max<uint64_t>(1,nnz/n),[&](uint64_t first,uint64_t last){for(uint64_t row=first;row<last;++row){double value=0;for(int k=offsets[row];k<offsets[row+1];++k)if(static_cast<uint64_t>(columns[k])==row)value=data[k];if(!std::isfinite(value)||value<=0)throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM Jacobi-CG requires a positive finite diagonal.");diagonal[row]=value;}});
    multiply(x,ap);for(uint64_t i=0;i<n;++i)r[i]=b[i]-ap[i];const auto normB=std::sqrt(std::max(0.L,dot(b,b))),tolerance=std::max(static_cast<long double>(atol),rtol*normB);
    auto checkResidual=[&]{const auto value=std::sqrt(std::max(0.L,dot(r,r)));result.residual=static_cast<double>(value);return value<=tolerance;};
    if(checkResidual()){result.converged=true;return result;}
    auto precondition=[&]{femRange(work,n,2,[&](uint64_t first,uint64_t last){for(uint64_t i=first;i<last;++i){z[i]=static_cast<double>(static_cast<long double>(r[i])/diagonal[i]);if(!std::isfinite(z[i]))throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM Jacobi preconditioning overflowed.");}});};precondition();p=z;auto rho=dot(r,z);
    while(result.iterations<work.request.max_iterations){work.check(0);multiply(p,ap);const auto denominator=dot(p,ap);if(!std::isfinite(denominator)||denominator<=0||!std::isfinite(rho)||rho<=0)throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM CG encountered a nonpositive/invalid curvature.");const auto alpha=rho/denominator;femRange(work,n,4,[&](uint64_t first,uint64_t last){for(uint64_t i=first;i<last;++i){x[i]=static_cast<double>(x[i]+alpha*p[i]);r[i]=static_cast<double>(r[i]-alpha*ap[i]);if(!std::isfinite(x[i])||!std::isfinite(r[i]))throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM CG update is nonfinite.");}});++result.iterations;
        const bool candidate=checkResidual();if(candidate||result.iterations%32==0){multiply(x,ap);for(uint64_t i=0;i<n;++i)r[i]=b[i]-ap[i];if(checkResidual()){result.converged=true;break;}if(candidate){precondition();p=z;rho=dot(r,z);continue;}}
        precondition();const auto next=dot(r,z);if(!std::isfinite(next)||next<=0)throw Failure(PENTA_NUMERIC_DOMAIN,"Parallel FEM CG residual lost positivity.");const auto beta=next/rho;femRange(work,n,2,[&](uint64_t first,uint64_t last){for(uint64_t i=first;i<last;++i)p[i]=static_cast<double>(z[i]+beta*p[i]);});rho=next;
    }
    multiply(x,ap);for(uint64_t i=0;i<n;++i)r[i]=b[i]-ap[i];result.converged=checkResidual();std::copy(x.begin(),x.end(),solution.GetData());return result;
}
