// Continuous native ARKODE adjoint. Forward interpolation is retained at EVERY
// accepted native step, independently of the caller's requested sample grid.
struct ArkReverseData {
    UserData& data;const Solution& forward;const RunningObjective& running;std::size_t n,np,m;
    std::vector<double> stateGradient,parameterGradient;
    void evaluate(double time,const double*lambda,double*out,SUNMatrix matrix){
        const auto low=std::min(forward.times.front(),forward.times.back()),high=std::max(forward.times.front(),forward.times.back());const auto roundoff=std::min(.01*(high-low),64*std::numeric_limits<double>::epsilon()*std::max({1.0,std::abs(low),std::abs(high)}));if(time<low&&low-time<=roundoff)time=low;if(time>high&&time-high<=roundoff)time=high;
        if(time<low||time>high){std::ostringstream error;error.precision(17);error<<"ARKODE reverse stage time "<<time<<" is outside native forward interval ["<<low<<","<<high<<"].";throw OdeError("O1012",error.str());}
        const auto point=denseEvaluate(forward,time);if(data.evaluate(time,point.data(),data.rhs.data(),data.jacobian.data()))throw modelFailure(*data.definition,data.error);
        if(np){data.settings->parameterJacobian(time,point.data(),data.parameterJacobian.data());data.applyMass(data.parameterJacobian.data(),np);}
        if(matrix){SUNMatZero(matrix);for(std::size_t row=0;row<n;++row)for(std::size_t col=0;col<n;++col)SM_ELEMENT_D(matrix,row,col)=-data.jacobian[col*n+row];for(std::size_t p=0;p<np;++p)for(std::size_t col=0;col<n;++col)SM_ELEMENT_D(matrix,n+p,col)=-data.parameterJacobian[col*np+p];}
        if(!out)return;
        double cost=0;if(running){std::fill(stateGradient.begin(),stateGradient.end(),std::numeric_limits<double>::quiet_NaN());std::fill(parameterGradient.begin(),parameterGradient.end(),std::numeric_limits<double>::quiet_NaN());cost=running(time,point.data(),data.parameters->data(),stateGradient.data(),np?parameterGradient.data():nullptr);if(!std::isfinite(cost))throw OdeError("O1012","Nonfinite ARKODE running objective.");}
        for(std::size_t row=0;row<n;++row){long double value=running?-stateGradient[row]:0;for(std::size_t col=0;col<n;++col)value-=static_cast<long double>(data.jacobian[col*n+row])*lambda[col];out[row]=static_cast<double>(value);}
        for(std::size_t p=0;p<np;++p){long double value=running?-parameterGradient[p]:0;for(std::size_t col=0;col<n;++col)value-=static_cast<long double>(data.parameterJacobian[col*np+p])*lambda[col];out[n+p]=static_cast<double>(value);}if(running)out[m-1]=-cost;for(std::size_t k=0;k<m;++k)if(!std::isfinite(out[k]))throw OdeError("O1012","Nonfinite ARKODE reverse gradient/quadrature.");
    }
    static int rhs(sunrealtype t,N_Vector y,N_Vector out,void*raw)noexcept{auto&self=*static_cast<ArkReverseData*>(raw);if(self.data.stop())return -1;try{self.evaluate(t,N_VGetArrayPointer(y),N_VGetArrayPointer(out),nullptr);return 0;}catch(const std::exception&e){self.data.evaluationFailed=true;self.data.failure=std::current_exception();try{self.data.error=e.what();}catch(...){}return -1;}catch(...){return -1;}}
    static int jacobian(sunrealtype t,N_Vector y,N_Vector,SUNMatrix matrix,void*raw,N_Vector,N_Vector,N_Vector)noexcept{auto&self=*static_cast<ArkReverseData*>(raw);if(self.data.stop())return -1;try{self.evaluate(t,N_VGetArrayPointer(y),nullptr,matrix);return 0;}catch(const std::exception&e){self.data.evaluationFailed=true;self.data.failure=std::current_exception();try{self.data.error=e.what();}catch(...){}return -1;}catch(...){return -1;}}
};
AdjointResult solveArkAdjoint(const language::OdeDefinition&definition,double gamma,const std::vector<double>&initial,const std::vector<double>&parameters,const TerminalObjective&objective,const SolveOptions&options,const NativeOptions&native,const RunningObjective&running){
    detail::checkCancelled(native);const auto generated=detail::generate(definition);validateValues(generated,gamma,options.t0,initial,parameters);auto settings=options;settings.denseOutput=true;const auto requested=sampleTimes(settings,generated.coordinates,generated.parameters);const auto model=detail::compile(generated,native);const auto started=Clock::now();const auto n=generated.coordinates,np=generated.parameters,m=n+np+(running?1:0);if(m>256)throw OdeError("O1012","Native ARKODE adjoints require at most256 state/parameter/quadrature coordinates.");
    const auto forward=solvePrepared(definition,generated,model.get(),gamma,initial,parameters,settings,native,requested);AdjointResult result;result.solution=forward;result.initialGradient.resize(n);result.parameterGradient.resize(np);const auto* final=forward->values.data()+forward->values.size()-n;result.objective=objective(settings.t1,final,parameters.data(),result.initialGradient.data(),result.parameterGradient.data());if(!std::isfinite(result.objective))throw OdeError("O1012","Nonfinite ARKODE terminal objective.");for(const auto*values:{&result.initialGradient,&result.parameterGradient})for(const auto v:*values)if(!std::isfinite(v))throw OdeError("O1012","Nonfinite ARKODE terminal gradient.");if(options.t0==options.t1)return result;
    if(forward->denseSegments.empty())throw OdeError("O1012","ARKODE reverse integration requires bounded native step interpolation, not output-sample interpolation.");
    UserData data;data.definition=&definition;data.model=model.get();data.options=&native;data.settings=&settings;data.parameters=&parameters;data.gamma=gamma;data.wallLimit=settings.maximumWallSeconds;data.start=started;data.solver="ARKODE";data.rhs.resize(n);data.jacobian.resize(n*n);data.parameterJacobian.resize(n*np);initializeMass(data);ArkReverseData reverse{data,*forward,running,n,np,m,std::vector<double>(n),std::vector<double>(np)};
    Resources resources;resources.arkode=true;if(SUNContext_Create(SUN_COMM_NULL,&resources.context)!=0)throw OdeError("O1007","Cannot allocate ARKODE reverse context.");SUNContext_ClearErrHandlers(resources.context);SUNContext_PushErrHandler(resources.context,sundialsError,&data);resources.state=N_VNew_Serial(static_cast<sunindextype>(m),resources.context);if(!resources.state)throw OdeError("O1007","Cannot allocate ARKODE reverse state.");resources.work=N_VClone(resources.state);if(!resources.work)throw OdeError("O1007","Cannot allocate ARKODE reverse interpolation buffer.");N_VConst(0,resources.state);std::copy(result.initialGradient.begin(),result.initialGradient.end(),N_VGetArrayPointer(resources.state));
    if(settings.method==Method::Erk)resources.integrator=ERKStepCreate(ArkReverseData::rhs,settings.t1,resources.state,resources.context);else resources.integrator=ARKStepCreate(nullptr,ArkReverseData::rhs,settings.t1,resources.state,resources.context);if(!resources.integrator)throw OdeError("O1007","Cannot allocate native ARKODE reverse integrator.");
    // The forward ESDIRK436 table has c=1.04, which samples beyond an epoch.
    // Its reverse continuous-adjoint adapter instead uses the fourth-order,
    // third-order embedded ARK436L2SA DIRK table with all c in[0,1].
    require(settings.method==Method::Erk?ERKStepSetTableNum(resources.integrator,ARKODE_DORMAND_PRINCE_7_4_5):ARKStepSetTableNum(resources.integrator,ARKODE_ARK436L2SA_DIRK_6_3_4,ARKODE_ERK_NONE),"reverse embedded table",data);require(ARKodeSetUserData(resources.integrator,&reverse),"reverse user data",data);require(ARKodeSStolerances(resources.integrator,settings.rtol,settings.atol),"reverse tolerances",data);
    // ARKODE otherwise permits an internal step past tstop and interpolates
    // back. Reverse RHS stages must stay in their forward epoch's domain.
    require(ARKodeSetInterpolateStopTime(resources.integrator,SUNFALSE),"reverse hard stop",data);require(ARKodeSetStopTime(resources.integrator,settings.t0),"reverse stop time",data);require(ARKodeSetMaxNumSteps(resources.integrator,static_cast<long>(settings.maxSteps)),"reverse step budget",data);
    if(settings.initialStep)require(ARKodeSetInitStep(resources.integrator,std::copysign(settings.initialStep,settings.t0-settings.t1)),"reverse initial step",data);
    if(settings.maximumStep)require(ARKodeSetMaxStep(resources.integrator,settings.maximumStep),"reverse maximum step",data);
    if(settings.minimumStep)require(ARKodeSetMinStep(resources.integrator,settings.minimumStep),"reverse minimum step",data);
    if(settings.method==Method::Esdirk){resources.matrix=SUNDenseMatrix(static_cast<sunindextype>(m),static_cast<sunindextype>(m),resources.context);if(!resources.matrix)throw OdeError("O1007","Cannot allocate ARKODE reverse matrix.");resources.linear=SUNLinSol_Dense(resources.state,resources.matrix,resources.context);if(!resources.linear)throw OdeError("O1007","Cannot allocate ARKODE reverse linear solver.");require(ARKodeSetLinearSolver(resources.integrator,resources.linear,resources.matrix),"reverse linear solver",data);require(ARKodeSetJacFn(resources.integrator,settings.jacobian=="analytic"?ArkReverseData::jacobian:nullptr),"reverse analytic Jacobian",data);}
    const auto direction=settings.t1>settings.t0?1.0:-1.0;sunrealtype reached=settings.t1;long steps=0;while(direction*(reached-settings.t0)>0){detail::checkCancelled(native);if(data.stop())checkStatus(-1,data,definition.span);const auto previous=reached;const auto status=ARKodeEvolve(resources.integrator,settings.t0,resources.state,&reached,ARK_ONE_STEP);checkStatus(status,data,definition.span);require(ARKodeGetNumSteps(resources.integrator,&steps),"reverse step count",data);if(static_cast<std::size_t>(steps)>settings.maxSteps)throw OdeError("O1006","ARKODE reverse integration exceeded its total step budget.");if(reached==previous)throw OdeError("O1007","ARKODE reverse integration made no time progress.");}
    require(ARKodeGetDky(resources.integrator,settings.t0,0,resources.work),"reverse endpoint interpolation",data);const auto*values=N_VGetArrayPointer(resources.work);std::copy_n(values,n,result.initialGradient.begin());for(std::size_t p=0;p<np;++p)result.parameterGradient[p]+=values[n+p];if(running){result.runningCost=values[m-1];result.objective+=result.runningCost;}result.backwardSteps=static_cast<std::size_t>(std::max(0L,steps));result.checkpoints=forward->denseSegments.size();for(const auto*gradient:{&result.initialGradient,&result.parameterGradient})for(const auto v:*gradient)if(!std::isfinite(v))throw OdeError("O1012","Nonfinite native ARKODE adjoint gradient.");if(!std::isfinite(result.objective))throw OdeError("O1012","Nonfinite native ARKODE objective.");std::const_pointer_cast<Solution>(forward)->stats.elapsedSeconds=std::chrono::duration<double>(Clock::now()-started).count();return result;
}
