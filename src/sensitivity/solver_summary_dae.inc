double daeSummary(const Model& model,const std::vector<double>& parameters){
    const auto n=model.stateCoordinates;
    struct Bridge {
        const Model& model;const native_functions::Callback& callback;std::vector<double> frame;std::exception_ptr failure;
        void fill(double time,const double* state,const double* derivative){frame[0]=time;std::copy_n(state,model.stateCoordinates,frame.begin()+1);std::copy_n(derivative,model.stateCoordinates,frame.begin()+static_cast<std::ptrdiff_t>(1+model.stateCoordinates));}
        int failed(char* error,uint64_t capacity){failure=std::current_exception();try{std::rethrow_exception(failure);}catch(const std::exception& e){copyError(error,capacity,e.what());}catch(...){}return 1;}
        static int residual(void* raw,double time,const double* state,const double* derivative,double* value,double* jy,double* jyp,char* error,uint64_t capacity)noexcept{auto& b=*static_cast<Bridge*>(raw);try{b.fill(time,state,derivative);const auto n=b.model.stateCoordinates;if(jy){native_functions::DerivativeRequest request;request.order=1;request.requestedThreads=1;request.active.resize(2*n);std::iota(request.active.begin(),request.active.end(),1);const auto result=b.callback.evaluate(b.model.gamma,b.frame,request);std::copy(result.values.begin(),result.values.end(),value);for(std::size_t row=0;row<n;++row)for(std::size_t col=0;col<n;++col){jy[row*n+col]=result.jacobian[row*2*n+col];jyp[row*n+col]=result.jacobian[row*2*n+n+col];}}else b.callback.evaluateValues(b.model.gamma,b.frame,std::span<double>(value,n));return 0;}catch(...){return b.failed(error,capacity);}}
        static int event(void* raw,double time,const double* state,const double* derivative,double* value,char* error,uint64_t capacity)noexcept{auto& b=*static_cast<Bridge*>(raw);try{b.fill(time,state,derivative);b.callback.evaluateValues(b.model.gamma,b.frame,std::span<double>(value,1));return 0;}catch(...){return b.failed(error,capacity);}}
    };
    std::vector<double> frame(1+2*n+parameters.size(),0);std::copy(parameters.begin(),parameters.end(),frame.begin()+static_cast<std::ptrdiff_t>(1+2*n));Bridge residual{model,*model.callback,frame,{}},event{model,model.event?*model.event:*model.callback,frame,{}};
    auto request=model.daeOptions;request.struct_size=sizeof(request);request.dimension=static_cast<std::uint32_t>(n);request.initial=model.initial.data();request.initial_derivative=model.initialDerivative.data();request.algebraic=model.algebraic.data();request.callback_context=&residual;request.residual=Bridge::residual;request.max_wall_seconds=std::min(request.max_wall_seconds,model.maximumSeconds);if(model.event){request.event_context=&event;request.event=Bridge::event;}
    dae::Result result;try{result=dae::Module(model.moduleDirectory).solve(request,model.native.cancellation,model.charge);}catch(...){if(residual.failure)std::rethrow_exception(residual.failure);if(event.failure)std::rethrow_exception(event.failure);throw;}
    if(model.summary==Summary::EventTime){require(model.eventIndex<result.eventTimes.size(),"Requested native DAE event was not observed.");return result.eventTimes[model.eventIndex];}
    require(!result.report.terminal_event&&!result.times.empty()&&result.times.back()==request.t1,"Native DAE stopped before the final observation; no partial summary was substituted.");return sampleSummary(result.times,result.values,n,model.coefficient,model.transient,model.summary,model.crossingLevel);
}
