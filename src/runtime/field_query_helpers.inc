    std::vector<double> sampleField(const plotting::FieldAnimationData& field,const std::vector<double>& points,std::size_t count,SourceSpan span){
        if(!count||count>4096||field.t.size()>std::min<std::size_t>(8000000,options_.maxMatrixCoordinates)/count/field.components)fail("R1022","Field probe output exceeds its retained-coordinate allowance.",span);
        struct Cell {std::size_t x=0,y=0;long double u=0,v=0;};std::vector<Cell> cells;cells.reserve(count);
        auto location=[&](const std::vector<double>& axis,double value){if(!std::isfinite(value)||value<axis.front()||value>axis.back())fail("R1022","Field probes must lie inside the saved spatial grid; extrapolation is not implicit.",span);const auto at=std::upper_bound(axis.begin(),axis.end(),value);const auto index=std::min<std::size_t>(axis.size()-2,static_cast<std::size_t>(at-axis.begin()-1));const long double fraction=(static_cast<long double>(value)-axis[index])/(static_cast<long double>(axis[index+1])-axis[index]);return std::pair{index,fraction};};
        for(std::size_t point=0;point<count;++point){const auto [x,u]=location(field.x,points[point*field.dimension]);Cell cell{x,0,u,0};if(field.dimension==2){const auto [y,v]=location(field.y,points[point*2+1]);cell.y=y;cell.v=v;}cells.push_back(cell);}
        const auto components=field.components,nodes=field.nx*field.ny;std::vector<double> values;values.reserve(field.t.size()*count*components);
        for(std::size_t time=0;time<field.t.size();++time)for(const auto& cell:cells)for(std::size_t component=0;component<components;++component){tick(span);auto entry=[&](std::size_t x,std::size_t y){return static_cast<long double>(field.values[(time*nodes+y*field.nx+x)*components+component]);};const auto first=(1-cell.u)*entry(cell.x,cell.y)+cell.u*entry(cell.x+1,cell.y);const auto value=field.dimension==1?first:(1-cell.v)*first+cell.v*((1-cell.u)*entry(cell.x,cell.y+1)+cell.u*entry(cell.x+1,cell.y+1));values.push_back(finite(static_cast<double>(value),span));}
        return values;
    }
    std::optional<Value> fieldQueryCall(const Expr& expression,const std::vector<Value>& arguments){
        const auto& name=expression.text;if(name!="fieldprobe"&&name!="fieldslice")return {};const auto span=expression.span;
        const auto field=fieldQueryInput(arguments[0],span);std::vector<double> positions;std::size_t count=0;std::vector<double> axis;std::string sourceAxis;double position=0;
        if(name=="fieldprobe"){if(arguments.size()!=2)fail("R1022","Use fieldprobe(field,coordinates), one point per row.",span);const auto points=numericArray(arguments[1],span);if(points.components!=1)fail("R1022","Spatial field probe coordinates must be real.",span);if(field->dimension==1){count=points.values.size();positions=points.values;}else{if(points.columns!=2)fail("R1022","A2D field probe requires x/y coordinate rows.",span);count=points.rows;positions=points.values;}}
        else{if(arguments.size()!=3||field->dimension!=2)fail("R1022","Use fieldslice(saved_2D_field,\"x\"/\"y\",position).",span);const auto* selected=std::get_if<std::string>(&arguments[1]);if(!selected||(*selected!="x"&&*selected!="y"))fail("R1022","Select the fixed spatial slice axis x or y.",span);sourceAxis=*selected;position=real(arguments[2],span);axis=sourceAxis=="x"?field->y:field->x;count=axis.size();for(const auto value:axis){positions.push_back(sourceAxis=="x"?position:value);positions.push_back(sourceAxis=="y"?position:value);}}
        const auto values=sampleField(*field,positions,count,span);std::string basis;for(const auto& label:field->basisLabels){if(!basis.empty())basis+=',';basis+=label;}
        if(name=="fieldprobe")return makeRecord({{"format",std::string("FieldProbes-v1")},{"t",numericResult(field->t,field->t.size(),1,1,span)},{"values",numericResult(values,field->t.size(),count*field->components,1,span)},{"points",numericResult(positions,count,field->dimension,1,span)},{"components",I(field->components)},{"probes",I(count)},{"dimension",I(field->dimension)},{"algebra_id",field->algebraId},{"algebra_hash",field->algebraHash},{"basis_labels",basis},{"interpolation",std::string("multilinear_saved_grid; no_time_interpolation")},{"value_layout",std::string("probe_major_then_complete_coefficients")},{"gamma",field->gamma}},span);
        return makeRecord({{"format",std::string("FieldSlice-v1")},{"dimension",I(1)},{"x",numericResult(axis,1,axis.size(),1,span)},{"t",numericResult(field->t,field->t.size(),1,1,span)},{"values",numericResult(values,field->t.size(),count*field->components,1,span)},{"components",I(field->components)},{"value_layout",std::string("node_coefficients")},{"algebra_id",field->algebraId},{"algebra_hash",field->algebraHash},{"basis_labels",basis},{"source_axis",sourceAxis},{"source_position",position},{"gamma",field->gamma}},span);
    }
