    std::optional<Value> geometryCall(const Expr& expression,const std::vector<Value>& arguments){
        const auto& name=expression.text;const auto span=expression.span;
        if(name!="surf"&&name!="imagesc"&&name!="contour"&&name!="isosurface"&&name!="curvegeometry")return {};
        if(name=="curvegeometry"){
            if(arguments.size()!=1)fail("R2110","Use curvegeometry(points), one 2D/3D point per row.",span);
            const auto p=numericArray(arguments[0],span);if(p.components!=1||p.rows<3||(p.columns!=2&&p.columns!=3))fail("R2110","Curve geometry needs at least three real points with two or three columns.",span);
            std::vector<double> arc(p.rows,0),tangent(p.rows*p.columns,0),normal(p.rows*p.columns,0),curvature(p.rows,0);
            for(std::size_t i=1;i<p.rows;++i){double d=0;for(std::size_t j=0;j<p.columns;++j){const double delta=p.values[i*p.columns+j]-p.values[(i-1)*p.columns+j];d+=delta*delta;}if(d==0)fail("R2110","Curve geometry rejects consecutive duplicate points.",span);arc[i]=arc[i-1]+std::sqrt(d);}
            for(std::size_t i=0;i<p.rows;++i){tick(span);const auto a=i?i-1:0,b=i+1<p.rows?i+1:p.rows-1;double speed=0;for(std::size_t j=0;j<p.columns;++j){const double d=(p.values[b*p.columns+j]-p.values[a*p.columns+j])/(arc[b]-arc[a]);tangent[i*p.columns+j]=d;speed+=d*d;}if(speed==0)fail("R2110","Curve tangent is undefined at a reversing cusp.",span);for(std::size_t j=0;j<p.columns;++j)tangent[i*p.columns+j]/=std::sqrt(speed);}
            for(std::size_t i=0;i<p.rows;++i){const auto a=i?i-1:0,b=i+1<p.rows?i+1:p.rows-1;double k=0;for(std::size_t j=0;j<p.columns;++j){const double d=(tangent[b*p.columns+j]-tangent[a*p.columns+j])/(arc[b]-arc[a]);normal[i*p.columns+j]=d;k+=d*d;}curvature[i]=std::sqrt(k);if(k>0)for(std::size_t j=0;j<p.columns;++j)normal[i*p.columns+j]/=std::sqrt(k);}
            return makeRecord({{"arc",numericResult(arc,p.rows,1,1,span)},{"length",arc.back()},{"tangent",numericResult(tangent,p.rows,p.columns,1,span)},{"normal",numericResult(normal,p.rows,p.columns,1,span)},{"curvature",numericResult(curvature,p.rows,1,1,span)},{"status",std::string("sampled_estimate")}},span);
        }
        const bool volume=name=="isosurface";if((volume&&arguments.size()!=5)||(!volume&&(arguments.size()<3||arguments.size()>(name=="contour"?4:3))))fail("R2110","Use surf/imagesc(x,y,Z), contour(x,y,Z[,levels]) or isosurface(x,y,z,values,level).",span);
        const auto x=numericVector(arguments[0],span,false),y=numericVector(arguments[1],span,false);std::vector<double> z,levels;const auto v=numericArray(arguments[volume?3:2],span);if(v.components!=1)fail("R2110","Select one real Pentarnion coefficient or defined real quantity before plotting a field.",span);
        if(volume){z=numericVector(arguments[2],span,false);levels={real(arguments[4],span)};if(v.values.size()!=x.size()*y.size()*z.size())fail("R2110","Volume samples use x-fastest order, with one flattened y-by-x slice per z coordinate.",span);}else if(v.columns!=x.size()||v.rows!=y.size())fail("R2110","Grid values must have length(y) rows and length(x) columns.",span);
        if(name=="contour"){if(arguments.size()==4){if(std::holds_alternative<MatrixValue>(arguments[3])||rangeValue(arguments[3]))levels=numericVector(arguments[3],span,false);else levels={real(arguments[3],span)};}else{const auto [low,high]=std::minmax_element(v.values.begin(),v.values.end());for(int i=1;i<=8;++i)levels.push_back(*low+(*high-*low)*i/9);}}
        penta_geometry_request_v1 request{};request.struct_size=sizeof(request);request.operation=name=="surf"?0:name=="imagesc"?1:name=="contour"?2:3;request.nx=x.size();request.ny=y.size();request.nz=z.size();request.level_count=levels.size();request.x=x.data();request.y=y.data();request.z=z.data();request.values=v.values.data();request.levels=levels.data();
        auto action=figureAction(FigureActionKind::Plot,span);action.dimensions=name=="surf"||volume?3:2;action.axes={-1,-1,-1};
        try{const auto m=pde::Module(options_.numericModuleDirectory).geometry(request,std::min<std::size_t>(1000000,options_.maxPlotPoints)-plotPoints_,options_.cancellation,[this,span](std::size_t work){chargeNumericWork(work,span);});PlotMesh mesh;mesh.label=name;mesh.scalars=m.scalars;for(std::size_t i=0;i<m.xyz.size();i+=3)mesh.points.push_back({m.xyz[i],m.xyz[i+1],m.xyz[i+2]});for(std::size_t i=0;i<m.faces.size();i+=3)mesh.triangles.push_back({m.faces[i],m.faces[i+1],m.faces[i+2]});for(std::size_t i=0;i<m.edges.size();i+=2)mesh.segments.push_back({m.edges[i],m.edges[i+1]});reservePlotPoints(mesh.points.size(),span);action.mesh=std::move(mesh);result_.figureActions.push_back(std::move(action));return I(0);}catch(const pde::Error& e){fail(e.status==3?"R1006":"R2110",e.what(),span);}
    }
