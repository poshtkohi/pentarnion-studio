    void exportDiscoveryHeatmap(const DiscoveryFields* record,const DiscoveryFields* fields,const DiscoveryFields* units,const std::vector<std::size_t>& ids,const std::function<void(const plotting::NativePanel&)>& save,SourceSpan span){
