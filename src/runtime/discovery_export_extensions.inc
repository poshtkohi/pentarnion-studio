        const auto axes=numericVector(*selection,span,false);const auto np=static_cast<std::size_t>(integer(record->at("parameter_count"),span));if(axes.size()!=2||axes[0]==axes[1])fail("R2051","Select two distinct heatmap parameter coordinates.",span);for(auto a:axes)if(a<1||a>np||a!=std::trunc(a))fail("R2051","Heatmap parameter coordinates are outside the declared real coefficient layout.",span);
        const auto parameters=numericArray(record->at("parameters"),span);const auto valueName=chaosText(fields,"heatmap_value","maximum_norm",span);if(valueName!="maximum_norm"&&valueName!="return_error"&&valueName!="rhs_norm"&&valueName!="period"&&valueName!="status_codes"&&valueName!="failure_reason_codes")fail("R2051","heatmap_value must select an available scalar discovery diagnostic.",span);
        const auto scores=numericVector(record->at(valueName),span,false),statuses=numericVector(record->at("status_codes"),span,false);std::vector<double> x,y;for(auto id:ids){x.push_back(parameters.values[(id-1)*np+static_cast<std::size_t>(axes[0]-1)]);y.push_back(parameters.values[(id-1)*np+static_cast<std::size_t>(axes[1]-1)]);}auto unique=[](auto& values){std::sort(values.begin(),values.end());values.erase(std::unique(values.begin(),values.end()),values.end());};unique(x);unique(y);
