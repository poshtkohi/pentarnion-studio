        for(std::size_t row=0;row<y.size();++row)for(std::size_t col=0;col<x.size();++col){const auto index=row*x.size()+col,id=grid[index];if(!id)fail("R2051","Incomplete heatmap Cartesian grid.",span);valid[index]=code||(statuses[id-1]>=1&&statuses[id-1]<=4)||(statuses[id-1]==8);mesh.points.push_back({x[col],y[row],0});mesh.scalars.push_back(valid[index]?scores[id-1]:0);}
