namespace {
using Rational=boost::multiprecision::cpp_rational;
using AffinePolynomial=std::vector<std::vector<Rational>>;
struct StructuralProof {
    const language::FunctionDefinition& function;std::size_t dimension=0,operations=0;
    Rational guarded(Rational value){if(++operations>250000||value.str().size()>512)throw std::runtime_error("Exact structural-proof arithmetic budget exceeded.");return value;}
    AffinePolynomial zero()const{return AffinePolynomial(17,std::vector<Rational>(dimension+1));}
    static bool parameterized(const AffinePolynomial& p){for(const auto& row:p)for(std::size_t k=1;k<row.size();++k)if(row[k]!=0)return true;return false;}
    Rational literal(std::string text){if(text.empty()||text.size()>128)throw std::runtime_error("Numeric literal exceeds the exact proof budget.");std::size_t offset=0;bool negative=false;if(text[0]=='+'||text[0]=='-'){negative=text[0]=='-';++offset;}std::string digits;int decimal=0;bool point=false;for(;offset<text.size()&&text[offset]!='e'&&text[offset]!='E';++offset){if(text[offset]=='.'&&!point){point=true;continue;}if(text[offset]<'0'||text[offset]>'9')throw std::runtime_error("Exact proof accepts decimal real/integer literals only.");digits+=text[offset];if(point)++decimal;}if(digits.empty())throw std::runtime_error("Empty exact numeric literal.");int exponent=0;if(offset<text.size()){const auto remainder=text.substr(offset+1);std::size_t used=0;exponent=std::stoi(remainder,&used);if(used!=remainder.size()||std::abs(exponent)>128)throw std::runtime_error("Exact decimal exponent exceeds the proof budget.");}Rational value=0;for(char digit:digits)value=guarded(value*10+(digit-'0'));const int shift=exponent-decimal;for(int k=0;k<std::abs(shift);++k)value=guarded(shift>0?Rational(value*10):Rational(value/10));return negative?-value:value;}
    AffinePolynomial multiply(const AffinePolynomial& a,const AffinePolynomial& b){if(parameterized(a)&&parameterized(b))throw std::runtime_error("Model is nonlinear in fitted parameters; affine structural proof does not apply.");auto result=zero();for(std::size_t i=0;i<17;++i)for(std::size_t j=0;j<17;++j)for(std::size_t k=0;k<=dimension;++k){if(++operations>250000)throw std::runtime_error("Exact structural-proof polynomial work budget exceeded.");Rational term=a[i][k]*b[j][0];if(k)term+=a[i][0]*b[j][k];if(term==0)continue;if(i+j>16)throw std::runtime_error("Independent-variable polynomial degree exceeds16.");result[i+j][k]=guarded(result[i+j][k]+term);}return result;}
    AffinePolynomial expression(const language::ExprPtr& e,std::size_t depth=0){if(!e||depth>64||++operations>250000)throw std::runtime_error("Exact structural-proof AST budget exceeded.");auto result=zero();
        if(e->kind==language::ExprKind::IntegerLiteral||e->kind==language::ExprKind::RealLiteral){result[0][0]=literal(e->text);return result;}
        if(e->kind==language::ExprKind::Reference){for(std::size_t k=0;k<function.parameters.size();++k)if(e->text==function.parameters[k].name){if(k==dimension)result[1][0]=1;else result[0][k+1]=1;return result;}throw std::runtime_error("Local/captured symbols are outside the affine polynomial proof subset.");}
        if(e->kind==language::ExprKind::Group)return expression(e->children.at(0),depth+1);
        if(e->kind==language::ExprKind::Unary&&(e->text=="+"||e->text=="-")){result=expression(e->children.at(0),depth+1);if(e->text=="-")for(auto& row:result)for(auto& value:row)value=-value;return result;}
        if(e->kind!=language::ExprKind::Binary||e->children.size()!=2)throw std::runtime_error("Functions, control flow and nonpolynomial expressions need a broader structural theorem; no numerical-rank substitute was used.");
        auto a=expression(e->children[0],depth+1),b=expression(e->children[1],depth+1);
        if(e->text=="+"||e->text=="-"){for(std::size_t i=0;i<17;++i)for(std::size_t k=0;k<=dimension;++k)result[i][k]=guarded(e->text=="+"?Rational(a[i][k]+b[i][k]):Rational(a[i][k]-b[i][k]));return result;}
        if(e->text=="*")return multiply(a,b);
        if(e->text=="/"){for(std::size_t i=0;i<17;++i)for(std::size_t k=0;k<=dimension;++k)if((i||k)&&b[i][k]!=0)throw std::runtime_error("Variable denominators are outside the affine polynomial proof subset.");if(b[0][0]==0)throw std::runtime_error("Zero exact denominator.");for(auto& row:a)for(auto& value:row)value=guarded(value/b[0][0]);return a;}
        if(e->text=="^"){for(std::size_t i=0;i<17;++i)for(std::size_t k=0;k<=dimension;++k)if((i||k)&&b[i][k]!=0)throw std::runtime_error("Structural proof powers require literal integer exponents.");const auto exponent=b[0][0].convert_to<int>();if(exponent<0||exponent>16||b[0][0]!=exponent)throw std::runtime_error("Structural proof powers are integers0..16.");result[0][0]=1;for(int k=0;k<exponent;++k)result=multiply(result,a);return result;}
        throw std::runtime_error("Unsupported operator in exact affine polynomial proof.");
    }
};
}
StructuralIdentifiability structuralIdentifiability(const language::FunctionDefinition& function){
    StructuralIdentifiability result;result.status="unsupported_model";StructuralProof proof{function};
    try{
        if(function.parameters.size()<2||function.parameters.size()>17||function.result!=language::Type::Real||function.body.size()!=1||function.body[0].kind!=language::StatementKind::Return)throw std::runtime_error("Structural proof requires one real scalar return expression with1..16 real fitted parameters and a trailing real independent variable.");
        for(const auto& parameter:function.parameters)if(parameter.type!=language::Type::Real)throw std::runtime_error("The affine polynomial structural theorem currently supports real scalar parameters only.");
        proof.dimension=function.parameters.size()-1;result.dimension=proof.dimension;result.independent=function.parameters.back().name;for(std::size_t k=0;k<result.dimension;++k){if(k)result.parameterNames+=",";result.parameterNames+=function.parameters[k].name;}const auto polynomial=proof.expression(function.body[0].expression);std::size_t degree=16;while(degree&&std::all_of(polynomial[degree].begin(),polynomial[degree].end(),[](const auto& value){return value==0;}))--degree;result.degree=degree;
        std::vector<std::vector<Rational>> matrix(degree+1,std::vector<Rational>(result.dimension));for(std::size_t row=0;row<=degree;++row){for(std::size_t col=0;col<result.dimension;++col){matrix[row][col]=polynomial[row][col+1];const double value=matrix[row][col].convert_to<double>();if(!std::isfinite(value))throw std::runtime_error("Exact coefficients exceed finite display range.");result.coefficients.push_back(value);result.coefficientExact+=matrix[row][col].str()+(col+1==result.dimension?"\n":",");}}
        std::vector<std::size_t> pivots;for(std::size_t col=0,row=0;col<result.dimension&&row<matrix.size();++col){std::size_t pivot=row;while(pivot<matrix.size()&&matrix[pivot][col]==0)++pivot;if(pivot==matrix.size())continue;std::swap(matrix[pivot],matrix[row]);const auto scale=matrix[row][col];for(auto& value:matrix[row])value=proof.guarded(value/scale);for(std::size_t other=0;other<matrix.size();++other)if(other!=row){const auto factor=matrix[other][col];for(std::size_t k=0;k<result.dimension;++k)matrix[other][k]=proof.guarded(matrix[other][k]-factor*matrix[row][k]);}pivots.push_back(col);++row;}
        result.rank=pivots.size();for(std::size_t free=0;free<result.dimension;++free)if(std::find(pivots.begin(),pivots.end(),free)==pivots.end()){std::vector<Rational> vector(result.dimension);vector[free]=1;for(std::size_t row=0;row<pivots.size();++row)vector[pivots[row]]=-matrix[row][free];for(std::size_t col=0;col<result.dimension;++col){const double value=vector[col].convert_to<double>();if(!std::isfinite(value))throw std::runtime_error("Nullspace exceeds finite display range.");result.nullspace.push_back(value);result.nullspaceExact+=vector[col].str()+(col+1==result.dimension?"\n":",");}}
        if(result.coefficientExact.size()+result.nullspaceExact.size()>65536)throw std::runtime_error("Exact proof certificate exceeds64KiB.");
        result.supported=true;result.identifiable=result.rank==result.dimension;result.status=result.identifiable?"globally_identifiable_affine_polynomial":"structurally_ambiguous_affine_polynomial";result.reason="Exact rational coefficient-matrix theorem for the ideal real curve observed over an open independent-variable interval. Noise, finite sampling, binary floating-point implementation and arbitrary nonlinear models are not covered.";
    }catch(const std::exception& e){result.supported=false;result.identifiable=false;result.reason=e.what();result.coefficients.clear();result.nullspace.clear();result.coefficientExact.clear();result.nullspaceExact.clear();result.rank=0;}
    result.operations=proof.operations;return result;
}
