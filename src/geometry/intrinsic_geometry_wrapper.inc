IntrinsicResult ExtraModule::intrinsic(penta_intrinsic_request_v1 request,const std::shared_ptr<std::atomic_bool>& cancellation,const std::function<void(std::size_t)>& charge)const{
    if(request.dimension<1||request.dimension>6||request.tensor_rank>4)throw Error(1,"Intrinsic geometry dimensions exceed their bound.");
    (void)api();const auto& capability=intrinsicCapability(path_);const auto n=request.dimension,n2=n*n,n3=n2*n,n4=n3*n;uint64_t count=1;for(unsigned k=0;k<request.tensor_rank;++k)count*=n;IntrinsicResult result;result.inverse.resize(n2);result.connection.resize(n3);result.connectionFirst.resize(n4);result.riemann.resize(n4);result.ricci.resize(n2);result.torsion.resize(n3);result.metricCovariant.resize(n3);if(request.tensor)result.tensorCovariant.resize(count*n);if(request.frame){result.frameConnection.resize(n3);result.frameBracket.resize(n3);result.frameMetric.resize(n2);}auto& out=result.report;out.struct_size=sizeof(out);out.tensor_capacity=result.tensorCovariant.size();out.inverse_metric=result.inverse.data();out.connection=result.connection.data();out.connection_first=result.connectionFirst.data();out.riemann=result.riemann.data();out.ricci=result.ricci.data();out.torsion=result.torsion.data();out.metric_covariant=result.metricCovariant.data();out.tensor_covariant=result.tensorCovariant.data();out.frame_connection=result.frameConnection.data();out.frame_bracket=result.frameBracket.data();out.frame_metric=result.frameMetric.data();Host context{cancellation,charge,{},{},{}};const auto host=context.descriptor();request.struct_size=sizeof(request);char error[1024]{};const auto status=capability.point(&host,&request,&out,error,sizeof(error));check(status,error,context);out.inverse_metric=out.connection=out.connection_first=out.riemann=out.ricci=out.torsion=out.metric_covariant=out.tensor_covariant=out.frame_connection=out.frame_bracket=out.frame_metric=nullptr;return result;
}
