    if(request.dimension<1||request.dimension>6)throw Error(1,"Chart transition dimension exceeds its bound.");
    (void)api();const auto& capability=intrinsicCapability(path_);const auto n=request.dimension;TransitionResult result;result.inverse.resize(n*n);if(request.metric)result.metric.resize(n*n);if(request.connection)result.connection.resize(n*n*n);if(request.vector)result.vector.resize(n);if(request.covector)result.covector.resize(n);auto& out=result.report;out.struct_size=sizeof(out);out.inverse_jacobian=result.inverse.data();out.metric=result.metric.data();out.connection=result.connection.data();out.vector=result.vector.data();out.covector=result.covector.data();request.struct_size=sizeof(request);char error[1024]{};const auto status=capability.transition(&request,&out,error,sizeof(error));if(status)throw Error(status,error[0]?error:"Native chart transition failed.");out.inverse_jacobian=out.metric=out.connection=out.vector=out.covector=nullptr;return result;
