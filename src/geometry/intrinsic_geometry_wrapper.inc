const penta_intrinsic_api_v1& intrinsicCapability(const std::filesystem::path& path){std::lock_guard lock(moduleMutex);const auto handle=modules.at(path).handle;
#ifdef _WIN32
    const auto query=reinterpret_cast<penta_intrinsic_query_function_v1>(reinterpret_cast<void*>(GetProcAddress(static_cast<HMODULE>(handle),"penta_intrinsic_query_v1")));
#else
    const auto query=reinterpret_cast<penta_intrinsic_query_function_v1>(dlsym(handle,"penta_intrinsic_query_v1"));
#endif
    const auto* result=query?query(PENTA_INTRINSIC_ABI_V1):nullptr;if(!result||result->struct_size<sizeof(*result)||result->abi_version!=PENTA_INTRINSIC_ABI_V1||!result->point||!result->transition)throw Error(5,"Loaded geometry module lacks the compatible intrinsic geometry capability.");return *result;
}
