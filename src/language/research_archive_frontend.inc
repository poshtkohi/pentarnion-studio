    std::optional<Type> checkResearchArchiveCall(const ExprPtr& value){
        const auto& name=value->text;const std::set<std::string> names{"savearchive","loadarchive","archiveinfo","archiveartifact","migrateexperiment","experimentcatalog","catalogueentry","replayexperiment"};if(!names.contains(name))return {};bool valid=true;auto require=[&](bool yes,const char* text){if(!yes){add("E2054",text,value->span);valid=false;}};const auto count=value->children.size();require(m_options.languageVersion=="0.2"&&!hasNamedArguments(value),"Archive/catalogue APIs require language0.2 and positional arguments.");if(name=="catalogueentry"){require(count==2,"Use catalogueentry(catalogue,index).");if(count>=2)require(value->children[0]->type==Type::Record&&value->children[1]->type==Type::Integer,"Catalogue and one-based integer index expected.");}else{require(count>=1&&count<=3,"Invalid archive/catalogue argument count.");if(!count)return Type::Invalid;require(value->children[0]->type==Type::String,"Archive/catalogue paths require strings.");}
        if(name=="savearchive"||name=="loadarchive"){require(count==2||count==3,"Use archive(path,data_or_template[,options]).");if(count>=2)require(value->children[1]->type==Type::Record,"Archive payload/template requires a typed record.");if(count==3)require(value->children[2]->type==Type::Record,"Archive options require a typed record.");if(name=="savearchive")return valid?Type::Void:Type::Invalid;if(count>=2)value->schema=value->children[1]->schema;return valid?Type::Record:Type::Invalid;}
        if(name=="migrateexperiment"){require(count==2||count==3,"Use migrateexperiment(old_path,new_path[,options]).");if(count>=2)require(value->children[1]->type==Type::String,"Migration destination requires a string.");if(count==3)require(value->children[2]->type==Type::Record,"Migration options require a record.");return valid?Type::Void:Type::Invalid;}
        if(name=="archiveartifact"){require(count==2,"Use archiveartifact(path,label) to retrieve checked opaque bytes.");if(count>=2)require(value->children[1]->type==Type::String,"Artifact label requires a string.");return valid?Type::String:Type::Invalid;}
        if(name=="archiveinfo")require(count==1,"archiveinfo requires one path.");
        if(name=="experimentcatalog"||name=="replayexperiment"){require(count==1||count==2,"Use catalogue/replay(path[,options]).");if(count==2)require(value->children[1]->type==Type::Record,"Catalogue/replay options require a typed record.");}
        auto schema=std::make_shared<ValueSchema>();if(name=="archiveinfo"){for(const auto field:{"format","name","scientific_hash","integrity_hash","source_hash"})schema->fields.push_back({field,Type::String,{}});for(const auto field:{"version","compatible","integrity_valid","invocations","calls","embedded_artifacts","history_complete","calls_complete","gamma_bound"})schema->fields.push_back({field,Type::Integer,{}});}else if(name=="experimentcatalog"){for(const auto field:{"format","encoded"})schema->fields.push_back({field,Type::String,{}});for(const auto field:{"version","count","invalid_files","files_scanned","bytes_read"})schema->fields.push_back({field,Type::Integer,{}});}else if(name=="catalogueentry"){for(const auto field:{"path","name","scientific_hash","source_hash","family","status"})schema->fields.push_back({field,Type::String,{}});for(const auto field:{"version","compatible","has_scalar"})schema->fields.push_back({field,Type::Integer,{}});schema->fields.push_back({"scalar",Type::Real,{}});}else{for(const auto field:{"format","output","variables","workspace_semantics"})schema->fields.push_back({field,Type::String,{}});for(const auto field:{"ok","invocations","operations","source_history_complete"})schema->fields.push_back({field,Type::Integer,{}});}value->schema=schema;return valid?Type::Record:Type::Invalid;
    }
