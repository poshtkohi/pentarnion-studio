    std::optional<Type> checkFieldQueryCall(const ExprPtr& value){
        const auto& name=value->text;if(name!="fieldprobe"&&name!="fieldslice")return {};const auto count=value->children.size();bool valid=m_options.languageVersion=="0.2"&&!hasNamedArguments(value);auto require=[&](bool okay,const char* message){if(!okay){add("E2018",message,value->span);valid=false;}};
        require(count==(name=="fieldprobe"?2u:3u),"Use fieldprobe(field,points) or fieldslice(field,axis,position).");if(count)require(value->children[0]->type==Type::Record,"Field queries require a saved structured PDE field record.");if(name=="fieldprobe"&&count>1)require(value->children[1]->type==Type::RealMatrix||rangeType(value->children[1]->type)||scalarType(value->children[1]->type),"Field probes use real coordinates.");if(name=="fieldslice"&&count==3){require(value->children[1]->type==Type::String,"Slice axis must be x or y text.");require(scalarType(value->children[2]->type),"Slice position must be real.");}
        auto schema=std::make_shared<ValueSchema>();for(const auto* field:{"format","algebra_id","algebra_hash","basis_labels","value_layout"})schema->fields.push_back({field,Type::String,{}});for(const auto* field:{"t","values"})schema->fields.push_back({field,Type::RealMatrix,{}});for(const auto* field:{"components","dimension"})schema->fields.push_back({field,Type::Integer,{}});schema->fields.push_back({"gamma",Type::Real,{}});if(name=="fieldprobe"){schema->fields.push_back({"points",Type::RealMatrix,{}});schema->fields.push_back({"probes",Type::Integer,{}});schema->fields.push_back({"interpolation",Type::String,{}});}else{schema->fields.push_back({"x",Type::RealMatrix,{}});schema->fields.push_back({"source_axis",Type::String,{}});schema->fields.push_back({"source_position",Type::Real,{}});}value->schema=schema;return valid?Type::Record:Type::Invalid;
    }
