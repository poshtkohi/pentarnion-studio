    std::optional<Type> checkGraphViewCall(const ExprPtr& value){
        const auto& name=value->text;if(name!="plotgraph"&&name!="graphlayout"&&name!="savegraphlayout"&&name!="loadgraphlayout")return {};
        bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2151",text,value->span);valid=false;}};require(m_options.languageVersion=="0.2","Graph views require language 0.2.");require(!hasNamedArguments(value),"Use positional graph data and a final options record.");const auto count=value->children.size();require(count>=1,"Graph view commands require a graph record.");if(count)require(value->children[0]->type==Type::Record,"Graph views require an immutable graph/digraph record.");
        if(name=="loadgraphlayout"){require(count==2,"Use loadgraphlayout(G,path).");if(count>=2)require(value->children[1]->type==Type::String,"Layout filename must be a string.");auto schema=std::make_shared<ValueSchema>();for(const auto* field:{"positions","selected_nodes","selected_edges","highlighted_nodes","highlighted_edges"})schema->fields.push_back({field,Type::RealMatrix,{}});for(const auto* field:{"dimensions","seed"})schema->fields.push_back({field,Type::Integer,{}});schema->fields.push_back({"radius",Type::Real,{}});for(const auto* field:{"layout","status"})schema->fields.push_back({field,Type::String,{}});value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;}
        if(name=="savegraphlayout"){require(count==3||count==4,"Use savegraphlayout(G,positions,path[,options]).");if(count>=2)require(value->children[1]->type==Type::RealMatrix,"Node positions require a real matrix.");if(count>=3)require(value->children[2]->type==Type::String,"Layout filename must be a string.");if(count==4)require(value->children[3]->type==Type::Record,"Layout settings require an options record.");return valid?Type::Void:Type::Invalid;}
        require(count<=static_cast<std::size_t>(name=="plotgraph"?3:2),"Incorrect graph view argument count.");if(count>=2)require(value->children[1]->type==Type::Record||(name=="plotgraph"&&value->children[1]->type==Type::RealMatrix),"Pass node positions or typed layout/view options.");if(count==3)require(value->children[2]->type==Type::Record,"Graph plot settings require a typed record.");return valid?(name=="plotgraph"?Type::Void:Type::RealMatrix):Type::Invalid;
    }
