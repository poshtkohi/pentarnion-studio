    std::optional<Type> checkFemAdaptiveCall(const ExprPtr& value){const auto& name=value->text;if(name!="femevaluate"&&name!="femadapt")return {};bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2245",text,value->span);valid=false;}};const auto count=value->children.size();if(name=="femevaluate"){require(count==3||count==4,"Use femevaluate(field,face_ids,reference_points[,options]).");if(count<3)return Type::Invalid;require(value->children[0]->type==Type::Record,"H1 evaluation requires a complete retained field.");require(value->children[1]->type==Type::RealMatrix||rangeType(value->children[1]->type),"H1 face indices are a real/integer vector.");require(value->children[2]->type==Type::RealMatrix,"H1 reference points areN-by2 real coordinates.");auto schema=std::make_shared<ValueSchema>();schema->fields={{"values",Type::RealMatrix,{}},{"native_work",Type::Integer,{}},{"threads_used",Type::Integer,{}},{"parallel_calls",Type::Integer,{}},{"algebra_id",Type::String,{}},{"algebra_hash",Type::String,{}},{"basis_labels",Type::String,{}}};value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;}auto base=std::make_shared<Expr>(*value);base->text="femsystem";const auto result=checkFemSystemCall(base);if(!result||*result==Type::Invalid)return Type::Invalid;auto schema=std::make_shared<ValueSchema>();schema->fields={{"field",Type::Record,base->schema},{"history",Type::RealMatrix,{}},{"indicator",Type::RealMatrix,{}},{"indicator_mesh",Type::Record,value->children[1]->schema},{"levels",Type::Integer,{}},{"converged",Type::Integer,{}},{"scaled_difference",Type::Real,{}},{"absolute_difference",Type::Real,{}},{"native_work",Type::Integer,{}},{"elapsed_seconds",Type::Real,{}},{"status",Type::String,{}},{"refinement",Type::String,{}},{"estimator",Type::String,{}}};value->schema=std::move(schema);return Type::Record;}
