#include "linear_dae_frontend.inc"
#include "structural_dae_frontend.inc"
    std::optional<Type> checkDaeCall(const ExprPtr& value){
        if(auto linear=checkLinearDaeCall(value))return linear;
        if(auto structural=checkStructuralDaeCall(value))return structural;
        if(value->text=="masssolve"){
            bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2401",text,value->span);valid=false;}};require(m_options.languageVersion=="0.2","Native mass systems require language0.2.");require(!hasNamedArguments(value),"Use positional masssolve arguments and a final options record.");require(value->children.size()==5,"Use masssolve(rhs,mass,y0,yp0,options(...)).");if(value->children.size()!=5)return Type::Invalid;require(value->children[0]->type==Type::Function&&value->children[1]->type==Type::Function,"RHS and mass require typed native-compatible callbacks.");for(unsigned j=2;j<4;++j){const auto type=value->children[j]->type;require(scalarType(type)||type==Type::Pentarnion||type==Type::Element||type==Type::Complex||type==Type::ElementMatrix||matrixType(type)||rangeType(type),"Mass initial data require complete checked numeric state coordinates.");}require(value->children[4]->type==Type::Record,"Mass-system options require a record.");auto schema=std::make_shared<ValueSchema>();for(const auto* field:{"t","values","derivatives","consistent_initial","consistent_derivative","algebraic"})schema->fields.push_back({field,Type::RealMatrix,{}});for(const auto* field:{"steps","residual_evaluations","jacobian_evaluations","native_operations","cache_hit","threads_used"})schema->fields.push_back({field,Type::Integer,{}});for(const auto* field:{"initial_residual_norm","initial_correction_norm","maximum_sample_residual","elapsed_seconds"})schema->fields.push_back({field,Type::Real,{}});for(const auto* field:{"cache_key","mass_cache_key","classification","index_contract","jacobian","method","status"})schema->fields.push_back({field,Type::String,{}});value->schema=schema;return valid?Type::Record:Type::Invalid;
        }
        if(value->text!="daesolve")return {};
        bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2400",text,value->span);valid=false;}};require(m_options.languageVersion=="0.2","DAEs require language0.2.");require(!hasNamedArguments(value),"Use positional DAE arguments and an options record.");require(value->children.size()==4,"Use daesolve(residual,y0,yp0,options(algebraic=mask,...)).");if(value->children.size()<4)return Type::Invalid;require(value->children[0]->type==Type::Function,"DAE residual requires a native-compatible typed function.");for(unsigned j=1;j<3;++j){const auto t=value->children[j]->type;require(scalarType(t)||t==Type::Pentarnion||t==Type::Element||t==Type::Complex||t==Type::ElementMatrix||t==Type::Tensor||t==Type::Tuple||matrixType(t)||rangeType(t),"DAE initial data require complete checked native scalar/array/tensor groups or explicit real coordinates.");}require(value->children[3]->type==Type::Record,"DAE options require a record with an explicit algebraic mask.");
        auto schema=std::make_shared<ValueSchema>();for(const auto field:{"t","values","derivatives","consistent_initial","consistent_derivative","algebraic","event_times","event_before","event_after"})schema->fields.push_back({field,Type::RealMatrix,{}});for(const auto field:{"events","steps","residual_evaluations","jacobian_evaluations","event_evaluations","native_operations","terminal_event","cache_hit","threads_used"})schema->fields.push_back({field,Type::Integer,{}});for(const auto field:{"initial_residual_norm","initial_correction_norm","maximum_sample_residual","elapsed_seconds"})schema->fields.push_back({field,Type::Real,{}});for(const auto field:{"initialization","jacobian","index_contract","method","status","cache_key","event_cache_key","reset_cache_key"})schema->fields.push_back({field,Type::String,{}});value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;
    }
