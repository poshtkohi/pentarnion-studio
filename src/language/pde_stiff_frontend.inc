        fields({"minimum_step","maximum_step","maximum_error_estimate","elapsed_seconds"},Type::Real);schema->fields.push_back({"domain",domain,value->children[1]->schema});value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;
