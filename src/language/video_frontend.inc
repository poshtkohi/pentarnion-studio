    std::optional<Type> checkVideoCall(const ExprPtr& value){
        if(value->text!="exportvideo")return {};
        bool valid=true;auto require=[&](bool okay,const char* message){if(!okay){add("E2018",message,value->span);valid=false;}};require(m_options.languageVersion=="0.2","Native video export requires language 0.2.");require(!hasNamedArguments(value),"Use exportvideo(field,path[,options]).");const auto count=value->children.size();require(count==2||count==3,"Use exportvideo(field,path[,options]).");if(count>=1)require(value->children[0]->type==Type::Record,"Video source must be a saved PDE field record.");if(count>=2)require(value->children[1]->type==Type::String,"Video destination must be an AVI filename string.");if(count==3)require(value->children[2]->type==Type::Record,"Video settings require a typed options record.");auto schema=std::make_shared<ValueSchema>();for(const auto* field:{"frames","bytes","width","height","physical_time_interpolated"})schema->fields.push_back({field,Type::Integer,{}});for(const auto* field:{"fps","duration_seconds","source_duration_seconds"})schema->fields.push_back({field,Type::Real,{}});for(const auto* field:{"path","codec","status"})schema->fields.push_back({field,Type::String,{}});value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;
