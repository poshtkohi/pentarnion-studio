    std::optional<Type> checkFemSystemCall(const ExprPtr& value){const auto& name=value->text;if(name!="femsystem"&&name!="femtime"&&name!="femsystemplot")return {};const std::size_t mandatory=name=="femsystemplot"?1:2;bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2240",text,value->span);valid=false;}};const auto count=value->children.size();require(m_options.languageVersion=="0.2","Native nonlinear system FEM requires language0.2.");require(count==mandatory||count==mandatory+1,"Use femsystem(reaction,mesh[,options]) or femsystemplot(field[,options]).");require(!hasNamedArguments(value),"FEM system builtins use positional arguments and typed options.");if(count<mandatory)return Type::Invalid;if(name=="femsystemplot"){require(value->children[0]->type==Type::Record,"femsystemplot requires a retained complete FEM system field.");return valid?Type::Void:Type::Invalid;}require(value->children[0]->type==Type::Function,"A nonlinear FEM reaction is compiled to a cached native callback with its analytic Jacobian.");require(value->children[1]->type==Type::Record,"FEM systems require a tagged triangle mesh.");if(count>mandatory)require(value->children.back()->type==Type::Record,"FEM solver options require a typed record.");auto schema=std::make_shared<ValueSchema>();schema->fields.push_back({"mesh",Type::Record,value->children[1]->schema});for(const auto* key:{"format","status","algebra_id","algebra_hash","basis_labels","value_layout","diffusion_side","geometry_kind","cache_keys","backend"})schema->fields.push_back({key,Type::String,{}});for(const auto* key:{"dof_coordinates","dof_values","vertex_dofs","element_dofs","visualization_vertices","visualization_values","visualization_triangles"})schema->fields.push_back({key,Type::RealMatrix,{}});for(const auto* key:{"dimension","components","order","visualization_refinement","dofs","converged","has_exact","newton_iterations","linear_iterations","reaction_evaluations","jacobian_evaluations","field_evaluations","geometry_evaluations","native_work","estimated_bytes","maximum_nonzeros","cache_hit","threads_requested","threads_granted","threads_used","parallel_calls"})schema->fields.push_back({key,Type::Integer,{}});for(const auto* key:{"residual_norm","relative_residual","l2_error"})schema->fields.push_back({key,Type::Real,{}});if(name=="femtime"){auto outer=std::make_shared<ValueSchema>();outer->fields.push_back({"field",Type::Record,schema});outer->fields.push_back({"mesh",Type::Record,value->children[1]->schema});for(const auto* key:{"format","status","value_layout","algebra_id","algebra_hash","basis_labels","integrator","cache_keys","residual_semantics"})outer->fields.push_back({key,Type::String,{}});for(const auto* key:{"t","values","points"})outer->fields.push_back({key,Type::RealMatrix,{}});for(const auto* key:{"nodes","components","dimension","accepted_steps","rejected_steps","converged","native_work","cache_hit","threads_used","parallel_calls"})outer->fields.push_back({key,Type::Integer,{}});for(const auto* key:{"minimum_step","maximum_step","maximum_error_estimate"})outer->fields.push_back({key,Type::Real,{}});schema=std::move(outer);}value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;}
