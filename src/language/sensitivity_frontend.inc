        auto schema=std::make_shared<ValueSchema>();for(const auto field:{"lower","upper","mu","mu_star","sigma","first_order","total_order","first_lower","first_upper","total_lower","total_upper"})schema->fields.push_back({field,Type::RealMatrix,{}});for(const auto field:{"samples","dimensions","seed","levels","bootstrap","evaluations","native_operations","cache_hit","threads_requested","threads_granted","threads_used","peak_active_threads","parallel_calls"})schema->fields.push_back({field,Type::Integer,{}});for(const auto field:{"mean","variance","confidence","elapsed_seconds"})schema->fields.push_back({field,Type::Real,{}});for(const auto field:{"method","distribution","estimator","uncertainty","effect_scale","cache_key","status"})schema->fields.push_back({field,Type::String,{}});value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;
