    std::optional<Type> checkSensitivityCall(const ExprPtr& value){
        if(value->text!="sensitivity")return {};
        bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2300",text,value->span);valid=false;}};
        require(m_options.languageVersion=="0.2","Global sensitivity requires language 0.2.");require(!hasNamedArguments(value),"Use positional sensitivity arguments and an options record.");const auto count=value->children.size();require(count==3||count==4,"Use sensitivity(model,lower,upper[,options]).");if(count<3)return Type::Invalid;
        require(value->children[0]->type==Type::Function,"Sensitivity requires a native-compatible model.");for(std::size_t j=1;j<3;++j)require(matrixType(value->children[j]->type)||rangeType(value->children[j]->type),"Sensitivity bounds require real vectors.");if(count==4)require(value->children[3]->type==Type::Record,"Sensitivity options require a record.");
