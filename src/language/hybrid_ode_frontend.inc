    std::optional<Type> checkHybridOdeCall(const ExprPtr& value){
        const auto& name=value->text;if(name!="hybridsolve"&&name!="hybridval"&&name!="hybridadjoint")return {};
        bool valid=true;auto require=[&](bool okay,const char* text){if(!okay){add("E2053",text,value->span);valid=false;}};const auto count=value->children.size();require(m_options.languageVersion=="0.2","Hybrid saltation/adjoint integration requires language0.2.");require(!hasNamedArguments(value),"Use positional hybrid arguments and a final typed options record.");
        if(name=="hybridval"){require(count==2||count==3,"Use hybridval(trajectory,times[,\"pre\"|\"post\"]).");if(count>=2){require(value->children[0]->type==Type::Record,"Hybrid queries require a trajectory record.");const auto type=value->children[1]->type;require(scalarType(type)||matrixType(type)||rangeType(type),"Hybrid query times must be real numeric values.");}if(count==3)require(value->children[2]->type==Type::String,"The exact jump side is pre or post.");return valid?Type::RealMatrix:Type::Invalid;}
        const bool adjoint=name=="hybridadjoint";const std::size_t required=adjoint?5:4;require(count==required||count==required+1,"Use hybridsolve(model,event,reset,initial[,options]) or hybridadjoint(model,event,reset,objective,initial[,options]).");
        if(count>=3)require(value->children[0]->type==Type::OdeModel&&value->children[1]->type==Type::Function&&value->children[2]->type==Type::Function,"Hybrid integration needs an explicit checked ODE and native event/reset functions.");
        if(adjoint&&count>=4)require(value->children[3]->type==Type::Function,"Hybrid terminal objectives require a typed native function.");
        if(count>=required){const auto type=value->children[required-1]->type;require(scalarType(type)||type==Type::Pentarnion||type==Type::Complex||type==Type::Element||type==Type::ElementMatrix||matrixType(type)||rangeType(type)||type==Type::Tuple,"Initial hybrid values must contain complete checked scalar/fixed-array state coordinates.");}
        if(count==required+1)require(value->children.back()->type==Type::Record,"Hybrid options require a typed record.");
        auto schema=std::make_shared<ValueSchema>();auto fields=[&](std::initializer_list<const char*> names,Type type){for(const auto* key:names)schema->fields.push_back({key,type,{}});};
        fields({"format","cache_key","event_cache_key","reset_cache_key","rhs_derivative_key","request_hash","state_names","coordinate_layout","sensitivity_layout","derivative_semantics","method","jacobian","source_hash","status"},Type::String);
        fields({"version","dimension","parameter_count","directions","segments","events","steps","evaluations","sensitivity_evaluations","event_evaluations","terminal_event","cache_hit","native_operations","threads_used"},Type::Integer);fields({"elapsed_seconds","gamma"},Type::Real);
        fields({"t","values","derivatives","sensitivities","segment_ids","sides","event_times","event_before","event_after","event_time_derivatives","event_fixed_before","event_fixed_after","event_total_before","event_total_after","saltation","parameter_jumps","event_denominators","transversality","terminal_time_derivatives","terminal_value_derivatives","initial","parameter_values","direction_parameters","direction_initials","initial_seeds","state_widths"},Type::RealMatrix);fields({"parameter_layout","settings"},Type::Record);
        auto eventInfo=std::make_shared<ValueSchema>();for(const auto* key:{"components","derivatives_available"})eventInfo->fields.push_back({key,Type::Integer,{}});for(const auto* key:{"indices","group_offsets","group_indices","directions","terminal","priorities"})eventInfo->fields.push_back({key,Type::RealMatrix,{}});for(const auto* key:{"time_tolerance","gradient_tolerance"})eventInfo->fields.push_back({key,Type::Real,{}});eventInfo->fields.push_back({"policy",Type::String,{}});schema->fields.push_back({"event_info",Type::Record,eventInfo});
        if(adjoint){auto nested=std::make_shared<ValueSchema>();for(const auto* key:{"objective","running_cost","event_cost","terminal_time"})nested->fields.push_back({key,Type::Real,{}});for(const auto* key:{"initial_gradient","parameter_gradient","event_before","event_after"})nested->fields.push_back({key,Type::RealMatrix,{}});for(const auto* key:{"backward_steps","replay_steps","checkpoints"})nested->fields.push_back({key,Type::Integer,{}});nested->fields.push_back({"elapsed_seconds",Type::Real,{}});for(const auto* key:{"objective_cache_key","running_cache_key","event_cost_cache_key","reverse_table","request_hash","status"})nested->fields.push_back({key,Type::String,{}});schema->fields.push_back({"adjoint",Type::Record,nested});}
        value->schema=std::move(schema);return valid?Type::Record:Type::Invalid;
    }
