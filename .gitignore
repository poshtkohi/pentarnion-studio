# Build trees, installed dependencies and downloaded source archives
/build/
/out/
/dist/
/release-assets/
/third-party/downloads/
/third-party/sources/
/third-party/*-sdk/
/third-party/*-install/
/third-party/windows-deps/
/third-party/linux-deps/
/third-party/msys2/
/third-party/venv/
/third-party/.venv/
/packaging/**/bin/
/packaging/**/sdk/
/packaging/components/**/vendor/
/packaging/**/wheel-cache/
/packaging/**/frozen-artifacts/
/packaging/**/frozen-source/

# Compiler outputs and local native caches
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
*.exe
*.pyd
*.mexw64
*.pch
*.gch
*.pyc
*.pyo
__pycache__/
.penta-cache/
.pentarnion-cache/
CMakeCache.txt
CMakeFiles/
compile_commands.json
CTestTestfile.cmake
Testing/
*.layout
*.cbTemp
*.depend
*.log
*.stamp

# Some upstream plain-text licences are named COPYING.LIB or LICENSE.LIB.
!/LICENSES/
!/LICENSES/**

# Local accounts, credentials, certificates and user settings
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
id_rsa*
id_ed25519*
local-build-config.json
CMakeUserPresets.json
.vs/
.vscode/
.idea/
*.user
*.autosave
*.bak
*.orig
*.swp
Thumbs.db
.DS_Store

# Private research material is not a repository input
/papers/
/references/
/personal-data/
/backups/
/prompts/

# Public release checksums are intentional; local invocation receipts are not
/publication-approval.json
/public-release-audit.json
