% Generated by Research Explorer. Inspect before Run; native bodies are cached.
use_algebra("A_gamma",gamma=1);
clear;
rng(5489);
ode research_model(t,real x,real v;real frequency){
x'=v;
v'=-frequency*x;
}
tic;
solution research_solution=odesolve(research_model,x=(1.0),v=(0.0),frequency=(1.0),t0=0,t1=10,sample_step=0.02,method="adams",jacobian="analytic",rtol=1e-08,atol=1e-10,max_seconds=60);
toc;
display(research_solution);
figure(60,"Name","Research Explorer: ODE coordinates","NumberTitle","off");clf;
subplot(1,2,1);plot(research_solution.t,research_solution.x);title("Full-state coordinate 1");xlabel("t");
subplot(1,2,2);plot(research_solution.t,research_solution.v);title("Full-state coordinate 2");xlabel("t");
