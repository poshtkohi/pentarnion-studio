% Generated by Research Explorer. Inspect this native model before Run.
use_algebra("A_gamma",gamma=1);
clear;
rng(5489);
native function real research_initial_profile(real x,real y,real domain_x,real domain_y,real amplitude,real wave){return amplitude*sin(wave*x/domain_x);}
native function real research_reaction(real u,real t,real x,real domain_x,real domain_y,real amplitude,real wave){return 0.0*u;}
matrix research_x=linspace(0.0,1,21);
matrix research_initial=zeros(1,21);
for(research_row=1:1){for(research_column=1:21){research_initial(research_row,research_column)=research_initial_profile(research_x(research_column),0.0,1,1,(1.0),(3.141592653589793));}}
record research_result=pdesolve(research_reaction,research_x,research_initial,options(parameters=options(domain_x=1,domain_y=1,amplitude=(1.0),wave=(3.141592653589793)),integrator="imex_euler",boundary="dirichlet",diffusion=0.10000000000000001,t0=0,t1=0.10000000000000001,time_step=0.002,sample_step=0.01,threads=0,max_wall_seconds=60,method="fd",length=1,left=(0.0),right=(0.0)));
display("Native PDE steps and observed threads:",research_result.steps,research_result.threads_used);
figure(60,"Name","Research Explorer: native PDE field","NumberTitle","off");clf;
matrix research_coordinate_field=pdecoeff(research_result,0);subplot(1,2,1);plot(research_x,research_coordinate_field(end,:));title("Final stored field coefficient");xlabel("x");subplot(1,2,2);imagesc(research_x,research_result.t,research_coordinate_field);title("Stored space-time field");xlabel("x");ylabel("t");
figure(61,"Name","Research Explorer: saved PDE playback","NumberTitle","off");clf;animatefield(research_result,options(component=0,fps=10,max_frames=240));
