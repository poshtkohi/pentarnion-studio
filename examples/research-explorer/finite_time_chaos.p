% Generated by Research Explorer. Inspect before Run; native bodies are cached.
use_algebra("A_gamma",gamma=1);
clear;
rng(5489);
ode research_model(t,real x,real y,real z;real sigma,real rho,real beta){
x'=sigma*(y-x);
y'=x*(rho-z)-y;
z'=x*y-beta*z;
}
record research_result=lyapunov(research_model,(1.0,1.0,1.0),options(parameters=options(sigma=(10.0),rho=(28.0),beta=(8.0/3.0)),t0=0,t1=20,transient=2,qr_step=0.25,method="adams",rtol=1e-08,atol=1e-10,max_seconds=60));
display(research_result);
figure(60,"Name","Research Explorer: finite-time tangent diagnostics","NumberTitle","off");clf;subplot(2,1,1);plot(research_result.t,research_result.history(:,1));title("Largest finite-time Lyapunov estimate");xlabel("t");subplot(2,1,2);matrix research_modes=1:research_result.dimension;plot(research_modes,research_result.exponents);title("Full-state spectrum; validate horizon and numerical settings");
