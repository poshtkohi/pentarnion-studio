% Generated by Research Explorer. Inspect before Run; native bodies are cached.
use_algebra("A_gamma",gamma=1);
clear;
rng(5489);
ode research_model(t,pentarnion p;pentarnion A,pentarnion B,real eta){
p'=A*p+(1-eta)*(B*(p*p))+eta*((B*p)*p);
}
tic;
solution research_solution=odesolve(research_model,p=((1-i-j+k-ell)/2),A=(-1.0/2-2*i+j/2-k-ell/2),B=(1+2*j-ell/2),eta=(0.0),t0=0,t1=20,sample_step=0.02,method="bdf",jacobian="analytic",rtol=1e-08,atol=1e-10,max_seconds=60);
toc;
display(research_solution);
figure(60,"Name","Research Explorer: ODE coordinates","NumberTitle","off");clf;
subplot(3,2,1);plot(research_solution.t,coeff(research_solution.p,0));title("Full-state coordinate 1");xlabel("t");
subplot(3,2,2);plot(research_solution.t,coeff(research_solution.p,1));title("Full-state coordinate 2");xlabel("t");
subplot(3,2,3);plot(research_solution.t,coeff(research_solution.p,2));title("Full-state coordinate 3");xlabel("t");
subplot(3,2,4);plot(research_solution.t,coeff(research_solution.p,3));title("Full-state coordinate 4");xlabel("t");
subplot(3,2,5);plot(research_solution.t,coeff(research_solution.p,4));title("Full-state coordinate 5");xlabel("t");
figure(61,"Name","Research Explorer: three-coordinate projection","NumberTitle","off");clf;plot3(coeff(research_solution.p,0),coeff(research_solution.p,1),coeff(research_solution.p,2));title("Projection; every original coefficient is retained");
