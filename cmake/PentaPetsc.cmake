# Optional, lazily loaded real PETSc backend. No PETSc header/library enters
# penta_runtime's public link interface or Studio's executable dependencies.
set(PENTA_PETSC_SDK "${CMAKE_CURRENT_SOURCE_DIR}/third-party/petsc-sdk" CACHE PATH "Pinned real PETSc SDK on Windows")
set(PENTA_PETSC_LINUX_SDK "${CMAKE_CURRENT_SOURCE_DIR}/third-party/petsc-linux-install" CACHE PATH "Project-local real PETSc SDK on Linux")
if(NOT WIN32 AND EXISTS "${PENTA_PETSC_LINUX_SDK}/lib/pkgconfig/PETSc.pc")
  list(PREPEND CMAKE_PREFIX_PATH "${PENTA_PETSC_LINUX_SDK}")
  set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH TRUE)
endif()
set(_penta_petsc_default OFF)
if(WIN32 AND EXISTS "${PENTA_PETSC_SDK}/ucrt64/lib/petsc/dso/libpetsc.dll.a")
  set(_penta_petsc_default ON)
else()
  find_package(PkgConfig QUIET)
  if(PkgConfig_FOUND)
    pkg_check_modules(_PENTA_PETSC_AVAILABLE QUIET PETSc>=3.25)
    if(_PENTA_PETSC_AVAILABLE_FOUND)
      set(_penta_petsc_default ON)
    endif()
  endif()
endif()
option(PENTA_BUILD_PETSC "Build the optional PETSc KSP/SNES module" ${_penta_petsc_default})
target_sources(penta_runtime PRIVATE src/petsc/petsc_solver.cpp)
if(PENTA_BUILD_PETSC)
  if(WIN32 AND EXISTS "${PENTA_PETSC_SDK}/ucrt64/lib/petsc/dso/libpetsc.dll.a")
    add_library(penta_petsc_dependency INTERFACE)
    target_include_directories(penta_petsc_dependency SYSTEM INTERFACE
      "${PENTA_PETSC_SDK}/ucrt64/include/petsc/dso" "${PENTA_PETSC_SDK}/ucrt64/include/petsc")
    target_link_libraries(penta_petsc_dependency INTERFACE "${PENTA_PETSC_SDK}/ucrt64/lib/petsc/dso/libpetsc.dll.a")
  else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(PENTA_PETSC REQUIRED IMPORTED_TARGET PETSc>=3.25)
    add_library(penta_petsc_dependency INTERFACE)
    target_link_libraries(penta_petsc_dependency INTERFACE PkgConfig::PENTA_PETSC)
  endif()
  add_library(penta_petsc MODULE src/modules/petsc_module.cpp)
  target_include_directories(penta_petsc PRIVATE src)
  target_link_libraries(penta_petsc PRIVATE penta_petsc_dependency penta_blas penta_warnings)
  set_target_properties(penta_petsc PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/modules" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/modules")
  if(WIN32)
    set_target_properties(penta_petsc PROPERTIES PREFIX "")
    file(GLOB _penta_petsc_runtime "${PENTA_PETSC_SDK}/ucrt64/bin/*.dll")
    foreach(_dependency IN LISTS _penta_petsc_runtime)
      add_custom_command(TARGET penta_petsc POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_dependency}" "$<TARGET_FILE_DIR:penta_petsc>")
    endforeach()
    install(FILES ${_penta_petsc_runtime} DESTINATION bin/modules)
  else()
    set_target_properties(penta_petsc PROPERTIES BUILD_RPATH "$ORIGIN;$ORIGIN/.." INSTALL_RPATH "$ORIGIN;$ORIGIN/..")
  endif()
  add_dependencies(penta_runtime penta_petsc)
  install(TARGETS penta_petsc RUNTIME DESTINATION bin/modules LIBRARY DESTINATION bin/modules)
  if(PENTA_BUILD_TESTS)
    add_executable(penta_petsc_kernel_tests tests/runtime/petsc_kernel_tests.cpp src/modules/petsc_module.cpp src/runtime/thread_budget.cpp)
    target_include_directories(penta_petsc_kernel_tests PRIVATE src)
    target_link_libraries(penta_petsc_kernel_tests PRIVATE penta_petsc_dependency penta_blas Threads::Threads penta_warnings)
    set_target_properties(penta_petsc_kernel_tests PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/modules")
    add_dependencies(penta_petsc_kernel_tests penta_petsc)
    add_test(NAME petsc_kernels COMMAND penta_petsc_kernel_tests)
    if(WIN32)
      set_tests_properties(petsc_kernels PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
    endif()
    add_executable(penta_petsc_language_tests tests/runtime/petsc_language_tests.cpp)
    target_link_libraries(penta_petsc_language_tests PRIVATE penta_runtime penta_warnings)
    target_compile_definitions(penta_petsc_language_tests PRIVATE PENTA_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}")
    add_test(NAME petsc_language COMMAND penta_petsc_language_tests)
  endif()
endif()
